unit uFrameHistoricoPedidos;

interface

uses
  System.SysUtils, System.Types, System.UITypes, System.Classes, System.Variants, 
  FMX.Types, FMX.Graphics, FMX.Controls, FMX.Forms, FMX.Dialogs, FMX.StdCtrls,
  FMX.Objects, FMX.Layouts, FMX.Controls.Presentation, System.Generics.Collections,
  uClienteLocal, uHistoricoPedidoModel, uHistoricoPedidoService,
  uFramePedidoHistorico, FMX.ListBox;

type
  TfraHistoricoPedidos = class(TFrame)
    rctFundo: TRectangle;
    lytTopo: TLayout;
    lblTitulo: TLabel;
    lblPeriodo: TLabel;
    VertScrollBox1: TVertScrollBox;
    lytLista: TLayout;
    cmbPeriodo: TComboBox;
    procedure cmbPeriodoChange(Sender: TObject);
  private
    FPedidos: TObjectList<TPedidoHistorico>;
    FOnAcompanhar: TPedidoHistoricoEvent;
    FOnRepetir: TPedidoHistoricoEvent;

    FDiasPeriodo: Integer;

    procedure LimparCartoes;
    procedure CartaoAcao(Sender: TObject; APedido: TPedidoHistorico);
  public
    constructor Create(AOwner: TComponent); override;
    destructor Destroy; override;

    procedure CarregarPedidos;

    property OnAcompanhar: TPedidoHistoricoEvent
      read FOnAcompanhar
      write FOnAcompanhar;

    property OnRepetir: TPedidoHistoricoEvent
      read FOnRepetir
      write FOnRepetir;
  end;

implementation

{$R *.fmx}

constructor TfraHistoricoPedidos.Create(
  AOwner: TComponent);
begin
  inherited;

  FPedidos :=
    TObjectList<TPedidoHistorico>.Create(True);

  FDiasPeriodo := 30;

  cmbPeriodo.ItemIndex := 1;
  cmbPeriodo.OnChange := cmbPeriodoChange;
end;

destructor TfraHistoricoPedidos.Destroy;
begin
  FPedidos.Free;
  inherited;
end;

procedure TfraHistoricoPedidos.LimparCartoes;
begin
  while lytLista.ChildrenCount > 0 do
    lytLista.Children[0].Free;
end;

procedure TfraHistoricoPedidos.CarregarPedidos;
const
  EMPRESA_ID =
    'c098af70-62d4-4c4a-88c5-3d38d31e725a';
var
  LCliente: TClienteLocal;
  LPedido: TPedidoHistorico;
  LCartao: TfraPedidoHistorico;
  LLabel: TLabel;
  LErro: string;
  LY: Single;
begin
  LimparCartoes;
  FPedidos.Clear;

  VertScrollBox1.ViewportPosition := PointF(0, 0);

  LCliente := TClienteLocal.Create;

  try
    LCliente.Carregar;

    if not THistoricoPedidoService.Carregar(
      EMPRESA_ID,
      LCliente.Telefone,
      30,
      FPedidos,
      LErro
    ) then
    begin
      LLabel := TLabel.Create(lytLista);
      LLabel.Parent := lytLista;
      LLabel.Align := TAlignLayout.None;
      LLabel.Position.Point := PointF(6, 10);
      LLabel.Width := lytLista.Width - 12;
      LLabel.Height := 70;
      LLabel.Text := LErro;
      LLabel.WordWrap := True;
      Exit;
    end;

    if FPedidos.Count = 0 then
    begin
      LLabel := TLabel.Create(lytLista);
      LLabel.Parent := lytLista;
      LLabel.Align := TAlignLayout.None;
      LLabel.Position.Point := PointF(6, 20);
      LLabel.Width := lytLista.Width - 12;
      LLabel.Height := 30;
      LLabel.Text := 'Nenhum pedido encontrado.';
      Exit;
    end;

    LY := 8;

    for LPedido in FPedidos do
    begin
      LCartao :=
        TfraPedidoHistorico.Create(lytLista);

      LCartao.Name := '';
      LCartao.Parent := lytLista;
      LCartao.Align := TAlignLayout.None;
      LCartao.Position.Point := PointF(6, LY);
      LCartao.Width := lytLista.Width - 12;
      LCartao.Height := 190;

      LCartao.Configurar(LPedido);
      LCartao.OnAcao := CartaoAcao;

      LY := LY + LCartao.Height + 12;
    end;

    lytLista.Height := LY + 12;
  finally
    LCliente.Free;
  end;
end;

procedure TfraHistoricoPedidos.CartaoAcao(
  Sender: TObject;
  APedido: TPedidoHistorico);
begin
  if not Assigned(APedido) then
    Exit;

  if APedido.EstaFinalizado then
  begin
    if Assigned(FOnRepetir) then
      FOnRepetir(Self, APedido);

    Exit;
  end;

  if APedido.EstaEmAndamento and
     Assigned(FOnAcompanhar) then
    FOnAcompanhar(Self, APedido);
end;

procedure TfraHistoricoPedidos.cmbPeriodoChange(
  Sender: TObject);
begin
  case cmbPeriodo.ItemIndex of
    0:
      FDiasPeriodo := 7;

    1:
      FDiasPeriodo := 30;

    2:
      FDiasPeriodo := 90;
  else
    FDiasPeriodo := 30;
  end;

  lblPeriodo.Text :=
    'Pedidos dos últimos ' +
    FDiasPeriodo.ToString +
    ' dias';

  CarregarPedidos;
end;

end.
