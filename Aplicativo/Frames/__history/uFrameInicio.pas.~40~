unit uFrameInicio;

interface

uses
  System.SysUtils, System.Types, System.UITypes, System.Classes, System.Variants, 
  FMX.Types, FMX.Graphics, FMX.Controls, FMX.Forms, FMX.Dialogs, FMX.StdCtrls,
  FMX.Layouts, FMX.Objects, FMX.Controls.Presentation, FMX.Edit;

type
  TfraInicio = class(TFrame)
    vsbConteudo: TVertScrollBox;
    lytCabecalho: TLayout;
    crlLogo: TCircle;
    lblLogo: TLabel;
    lblNomeLoja: TLabel;
    lblStatusLoja: TLabel;
    rctBusca: TRectangle;
    lblIconeBusca: TLabel;
    edtBusca: TEdit;
    rctBanner: TRectangle;
    lblBannerTitulo: TLabel;
    lblBannerTexto: TLabel;
    rctBannerBotao: TRectangle;
    lblBannerBotao: TLabel;
    lblTituloCategorias: TLabel;
    hsbCategorias: THorzScrollBox;
    lblTituloDestaques: TLabel;
    flwProdutos: TFlowLayout;
    procedure edtBuscaTyping(Sender: TObject);
    procedure rctBannerBotaoClick(Sender: TObject);
  private
    FCategoriaSelecionada: Integer;

    procedure CarregarDadosTemporarios;

    procedure CriarCategoria(
      const AId: Integer;
      const ANome: string;
      const AIcone: string
    );

    procedure CriarProduto(
      const AId: Integer;
      const ANome: string;
      const ADescricao: string;
      const AValor: Currency
    );

    procedure CarregarDadosTemporarios;
    procedure AjustarAlturaProdutos;
    procedure CategoriaClick(Sender: TObject);
    procedure ProdutoClick(Sender: TObject);
  public
    constructor Create(AOwner: TComponent); override;
  end;

implementation

{$R *.fmx}

uses uConstantes;

constructor TfraInicio.Create(AOwner: TComponent);
begin
  inherited;

  CarregarDadosTemporarios;
end;

procedure TfraInicio.CarregarDadosTemporarios;
begin
  CriarCategoria(1, 'Pizzas', '🍕');
  CriarCategoria(2, 'Lanches', '🍔');
  CriarCategoria(3, 'Porções', '🍟');
  CriarCategoria(4, 'Bebidas', '🥤');
  CriarCategoria(5, 'Sobremesas', '🍰');

  CriarProduto(
    1,
    'Pizza Calabresa',
    'Molho, mussarela, calabresa e cebola',
    49.90
  );

  CriarProduto(
    2,
    'Pizza Frango',
    'Frango, mussarela e catupiry',
    54.90
  );

  CriarProduto(
    3,
    'X-Bacon',
    'Hambúrguer, bacon, queijo e salada',
    29.90
  );

  CriarProduto(
    4,
    'Batata especial',
    'Batata frita com cheddar e bacon',
    24.90
  );

  AjustarAlturaProdutos;
end;

procedure TfraInicio.CriarCategoria(
  const AId: Integer;
  const ANome: string;
  const AIcone: string);
var
  LCard: TRectangle;
  LIcone: TLabel;
  LNome: TLabel;
begin
  LCard := TRectangle.Create(hsbCategorias);
  LCard.Parent := hsbCategorias;
  LCard.Width := 82;
  LCard.Height := 82;
  LCard.Position.X := hsbCategorias.Content.ChildrenCount * 92;
  LCard.Position.Y := 4;
  LCard.Fill.Color := COR_CARD;
  LCard.Stroke.Color := COR_BORDA;
  LCard.Stroke.Thickness := 1;
  LCard.XRadius := 16;
  LCard.YRadius := 16;
  LCard.Tag := AId;
  LCard.Cursor := crHandPoint;
  LCard.OnClick := CategoriaClick;

  LIcone := TLabel.Create(LCard);
  LIcone.Parent := LCard;
  LIcone.Align := TAlignLayout.Top;
  LIcone.Height := 48;
  LIcone.Text := AIcone;
  LIcone.TextSettings.Font.Size := 25;
  LIcone.TextSettings.HorzAlign := TTextAlign.Center;
  LIcone.TextSettings.VertAlign := TTextAlign.Center;
  LIcone.HitTest := False;

  LNome := TLabel.Create(LCard);
  LNome.Parent := LCard;
  LNome.Align := TAlignLayout.Client;
  LNome.Text := ANome;
  LNome.TextSettings.Font.Size := 11;
  LNome.TextSettings.Font.Style := [TFontStyle.fsBold];
  LNome.TextSettings.FontColor := COR_TEXTO;
  LNome.TextSettings.HorzAlign := TTextAlign.Center;
  LNome.TextSettings.VertAlign := TTextAlign.Center;
  LNome.HitTest := False;
end;

procedure TfraInicio.CriarProduto(
  const AId: Integer;
  const ANome: string;
  const ADescricao: string;
  const AValor: Currency);
var
  LCard: TRectangle;
  LImagem: TRectangle;
  LIcone: TLabel;
  LNome: TLabel;
  LDescricao: TLabel;
  LPreco: TLabel;
  LBotao: TCircle;
  LBotaoTexto: TLabel;
begin
  LCard := TRectangle.Create(flwProdutos);
  LCard.Parent := flwProdutos;
  LCard.Width := 170;
  LCard.Height := 245;
  LCard.Margins.Left := 2;
  LCard.Margins.Top := 4;
  LCard.Margins.Right := 2;
  LCard.Margins.Bottom := 10;
  LCard.Fill.Color := COR_CARD;
  LCard.Stroke.Color := COR_BORDA;
  LCard.Stroke.Thickness := 1;
  LCard.XRadius := 18;
  LCard.YRadius := 18;
  LCard.Tag := AId;
  LCard.Cursor := crHandPoint;
  LCard.OnClick := ProdutoClick;
  LCard.ClipChildren := True;

  LImagem := TRectangle.Create(LCard);
  LImagem.Parent := LCard;
  LImagem.Align := TAlignLayout.Top;
  LImagem.Height := 125;
  LImagem.Fill.Color := COR_PRIMARIA_CLARA;
  LImagem.Stroke.Kind := TBrushKind.None;
  LImagem.HitTest := False;

  LIcone := TLabel.Create(LImagem);
  LIcone.Parent := LImagem;
  LIcone.Align := TAlignLayout.Client;
  LIcone.Text := '🍕';
  LIcone.TextSettings.Font.Size := 52;
  LIcone.TextSettings.HorzAlign := TTextAlign.Center;
  LIcone.TextSettings.VertAlign := TTextAlign.Center;
  LIcone.HitTest := False;

  LNome := TLabel.Create(LCard);
  LNome.Parent := LCard;
  LNome.Position.X := 12;
  LNome.Position.Y := 135;
  LNome.Width := 145;
  LNome.Height := 24;
  LNome.Text := ANome;
  LNome.TextSettings.Font.Size := 14;
  LNome.TextSettings.Font.Style := [TFontStyle.fsBold];
  LNome.TextSettings.FontColor := COR_TEXTO;
  LNome.HitTest := False;

  LDescricao := TLabel.Create(LCard);
  LDescricao.Parent := LCard;
  LDescricao.Position.X := 12;
  LDescricao.Position.Y := 160;
  LDescricao.Width := 145;
  LDescricao.Height := 40;
  LDescricao.Text := ADescricao;
  LDescricao.WordWrap := True;
  LDescricao.TextSettings.Font.Size := 10;
  LDescricao.TextSettings.FontColor := COR_TEXTO_SECUNDARIO;
  LDescricao.HitTest := False;

  LPreco := TLabel.Create(LCard);
  LPreco.Parent := LCard;
  LPreco.Position.X := 12;
  LPreco.Position.Y := 207;
  LPreco.Width := 100;
  LPreco.Height := 25;
  LPreco.Text := FormatFloat('R$ #,##0.00', AValor);
  LPreco.TextSettings.Font.Size := 14;
  LPreco.TextSettings.Font.Style := [TFontStyle.fsBold];
  LPreco.TextSettings.FontColor := COR_PRIMARIA;
  LPreco.HitTest := False;

  LBotao := TCircle.Create(LCard);
  LBotao.Parent := LCard;
  LBotao.Position.X := 128;
  LBotao.Position.Y := 202;
  LBotao.Width := 32;
  LBotao.Height := 32;
  LBotao.Fill.Color := COR_PRIMARIA;
  LBotao.Stroke.Kind := TBrushKind.None;
  LBotao.HitTest := False;

  LBotaoTexto := TLabel.Create(LBotao);
  LBotaoTexto.Parent := LBotao;
  LBotaoTexto.Align := TAlignLayout.Client;
  LBotaoTexto.Text := '+';
  LBotaoTexto.TextSettings.Font.Size := 20;
  LBotaoTexto.TextSettings.Font.Style := [TFontStyle.fsBold];
  LBotaoTexto.TextSettings.FontColor := TAlphaColorRec.White;
  LBotaoTexto.TextSettings.HorzAlign := TTextAlign.Center;
  LBotaoTexto.TextSettings.VertAlign := TTextAlign.Center;
  LBotaoTexto.HitTest := False;
end;

procedure TfraInicio.AjustarAlturaProdutos;
var
  LQuantidade: Integer;
  LLinhas: Integer;
begin
  LQuantidade := flwProdutos.ChildrenCount;

  if LQuantidade = 0 then
  begin
    flwProdutos.Height := 0;
    Exit;
  end;

  LLinhas := (LQuantidade + 1) div 2;
  flwProdutos.Height := LLinhas * 260;
end;

procedure TfraInicio.CategoriaClick(Sender: TObject);
var
  LCategoriaId: Integer;
begin
  if not (Sender is TRectangle) then
    Exit;

  LCategoriaId := TRectangle(Sender).Tag;

  // Depois será substituído pela consulta da API.
  lblTituloDestaques.Text :=
    'Produtos da categoria ' + LCategoriaId.ToString;
end;

procedure TfraInicio.ProdutoClick(Sender: TObject);
var
  LProdutoId: Integer;
begin
  if not (Sender is TRectangle) then
    Exit;

  LProdutoId := TRectangle(Sender).Tag;

  ShowMessage(
    'Abrir detalhes do produto: ' +
    LProdutoId.ToString
  );
end;

procedure TfraInicio.edtBuscaTyping(Sender: TObject);
begin
  // Depois filtraremos a lista usando o texto digitado.
end;

procedure TfraInicio.rctBannerBotaoClick(Sender: TObject);
begin
  // Depois navegaremos para a aba Cardápio.
end;

end.
