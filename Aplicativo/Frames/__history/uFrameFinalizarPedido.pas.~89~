unit uFrameFinalizarPedido;

interface

uses
  System.SysUtils,
  System.Classes,
  System.UITypes,
  System.Types,
  FMX.Controls,
  FMX.Forms,
  FMX.StdCtrls,
  FMX.Objects,
  FMX.Layouts,
  FMX.Edit,
  FMX.Memo,
  FMX.ListBox,
  FMX.Dialogs,
  uCarrinhoModel, FMX.Memo.Types, FMX.ScrollBox, FMX.Controls.Presentation,
  FMX.Types, uClienteLocal;

type
  TTipoRecebimento = (
    trEntrega,
    trRetirada
  );

  TDadosFinalizacaoPedido = class
  public
    Nome: string;
    Telefone: string;

    TipoRecebimento: TTipoRecebimento;

    Cep: string;
    Endereco: string;
    Numero: string;
    Complemento: string;
    Bairro: string;
    Referencia: string;

    FormaPagamento: string;
    ValorTroco: Currency;
    Observacao: string;

    Subtotal: Currency;
    TaxaEntrega: Currency;
    Total: Currency;
  end;

  TPedidoConfirmadoEvent = procedure(
    Sender: TObject;
    ADados: TDadosFinalizacaoPedido
  ) of object;

  TfraFinalizarPedido = class(TFrame)
    rctFundo: TRectangle;
    rctTopo: TRectangle;
    rctVoltar: TRectangle;
    lblVoltar: TLabel;
    lblTitulo: TLabel;
    lblSubtitulo: TLabel;

    vsbConteudo: TVertScrollBox;

    lblTituloCliente: TLabel;
    rctNome: TRectangle;
    edtNome: TEdit;
    rctTelefone: TRectangle;
    edtTelefone: TEdit;

    lblTituloRecebimento: TLabel;
    lytTipoRecebimento: TLayout;

    rctEntrega: TRectangle;
    lblIconeEntrega: TLabel;
    lblEntrega: TLabel;
    lblEntregaDescricao: TLabel;

    rctRetirada: TRectangle;
    lblIconeRetirada: TLabel;
    lblRetirada: TLabel;
    lblRetiradaDescricao: TLabel;

    lytEndereco: TLayout;
    lblTituloEndereco: TLabel;
    rctCep: TRectangle;
    edtCep: TEdit;
    rctEndereco: TRectangle;
    edtEndereco: TEdit;

    lytNumeroComplemento: TLayout;
    rctNumero: TRectangle;
    edtNumero: TEdit;
    rctComplemento: TRectangle;
    edtComplemento: TEdit;

    rctBairro: TRectangle;
    edtBairro: TEdit;
    rctReferencia: TRectangle;
    edtReferencia: TEdit;

    lblTituloPagamento: TLabel;
    rctFormaPagamento: TRectangle;
    cboFormaPagamento: TComboBox;

    lytTroco: TLayout;
    lblTroco: TLabel;
    rctValorTroco: TRectangle;
    edtValorTroco: TEdit;

    lblTituloObservacao: TLabel;
    rctObservacao: TRectangle;
    memObservacao: TMemo;
    lytEspacoFinal: TLayout;

    rctRodape: TRectangle;
    lblSubtotalTitulo: TLabel;
    lblSubtotal: TLabel;
    lblEntregaTitulo: TLabel;
    lblEntregaValor: TLabel;
    rctSeparador: TRectangle;
    lblTotalTitulo: TLabel;
    lblTotal: TLabel;
    rctConfirmar: TRectangle;
    lblConfirmar: TLabel;

    procedure rctVoltarClick(Sender: TObject);
    procedure rctEntregaClick(Sender: TObject);
    procedure rctRetiradaClick(Sender: TObject);
    procedure cboFormaPagamentoChange(Sender: TObject);
    procedure rctConfirmarClick(Sender: TObject);
    procedure FrameResize(Sender: TObject);
  private
    FTipoRecebimento: TTipoRecebimento;
    FTaxaEntrega: Currency;
    FTaxaEntregaAtual: Currency;

    FOnVoltar: TNotifyEvent;
    FOnPedidoConfirmado: TPedidoConfirmadoEvent;

    procedure SelecionarTipoRecebimento(
      const ATipo: TTipoRecebimento
    );

    procedure AtualizarVisualRecebimento;
    procedure AtualizarFormaPagamento;
    procedure AtualizarResumo;
    procedure AjustarLayout;
    procedure CarregarDadosClienteLocal;

    function ValidarCampos: Boolean;
    function TextoFormaPagamento: string;
    function ConverterTextoCurrency(const ATexto: string; out AValor: Currency): Boolean;
    procedure SalvarDadosCliente;

    function CriarDadosPedido: TDadosFinalizacaoPedido;
  public
    constructor Create(AOwner: TComponent); override;

    procedure PrepararTela;
    procedure LimparCampos;
    procedure SalvarDadosClienteLocal;

    property TaxaEntrega: Currency
      read FTaxaEntrega
      write FTaxaEntrega;

    property TipoRecebimento: TTipoRecebimento
      read FTipoRecebimento;

    property OnVoltar: TNotifyEvent
      read FOnVoltar
      write FOnVoltar;

    property OnPedidoConfirmado: TPedidoConfirmadoEvent
      read FOnPedidoConfirmado
      write FOnPedidoConfirmado;
  end;

implementation

{$R *.fmx}

constructor TfraFinalizarPedido.Create(AOwner: TComponent);
begin
  inherited;

  FTaxaEntrega := 8.00;
  FTipoRecebimento := trEntrega;

  SelecionarTipoRecebimento(trEntrega);
  AtualizarFormaPagamento;
  AtualizarResumo;
end;

procedure TfraFinalizarPedido.PrepararTela;
begin
  CarregarDadosClienteLocal;
  AtualizarVisualRecebimento;
  AtualizarFormaPagamento;
  AtualizarResumo;

  vsbConteudo.ViewportPosition := PointF(0, 0);
end;

procedure TfraFinalizarPedido.LimparCampos;
begin
  edtNome.Text := '';
  edtTelefone.Text := '';

  edtCep.Text := '';
  edtEndereco.Text := '';
  edtNumero.Text := '';
  edtComplemento.Text := '';
  edtBairro.Text := '';
  edtReferencia.Text := '';

  cboFormaPagamento.ItemIndex := -1;
  edtValorTroco.Text := '';
  memObservacao.Text := '';

  SelecionarTipoRecebimento(trEntrega);
  AtualizarFormaPagamento;
end;

procedure TfraFinalizarPedido.SelecionarTipoRecebimento(
  const ATipo: TTipoRecebimento);
begin
  FTipoRecebimento := ATipo;

  { Endereço só aparece para entrega }
  lytEndereco.Visible :=
    FTipoRecebimento = trEntrega;

  AtualizarVisualRecebimento;
  AtualizarResumo;
end;

procedure TfraFinalizarPedido.AtualizarVisualRecebimento;
begin
  if FTipoRecebimento = trEntrega then
  begin
    rctEntrega.Fill.Color := $FFF6F4FF;
    rctEntrega.Stroke.Color := $FFFF4B0A;
    rctEntrega.Stroke.Thickness := 2;

    rctRetirada.Fill.Color := $FFFFFFFF;
    rctRetirada.Stroke.Color := $FFE7E8EE;
    rctRetirada.Stroke.Thickness := 1;

    lytEndereco.Visible := True;
    lblSubtitulo.Text := 'Informe os dados para entrega';
  end
  else
  begin
    rctEntrega.Fill.Color := $FFFFFFFF;
    rctEntrega.Stroke.Color := $FFE7E8EE;
    rctEntrega.Stroke.Thickness := 1;

    rctRetirada.Fill.Color := $FFF6F4FF;
    rctRetirada.Stroke.Color := $FFFF4B0A;
    rctRetirada.Stroke.Thickness := 2;

    lytEndereco.Visible := False;
    lblSubtitulo.Text := 'Informe os dados para retirada';
  end;
end;

procedure TfraFinalizarPedido.AtualizarFormaPagamento;
begin
  lytTroco.Visible :=
    SameText(
      TextoFormaPagamento,
      'Dinheiro'
    );

  if not lytTroco.Visible then
    edtValorTroco.Text := '';
end;

procedure TfraFinalizarPedido.AtualizarResumo;
var
  LSubtotal: Currency;
  LEntrega: Currency;
  LTotal: Currency;
begin
  LSubtotal :=
    TCarrinho.Instancia.ValorTotal;

  if (FTipoRecebimento = trEntrega) and
     (TCarrinho.Instancia.QuantidadeItens > 0) then
    LEntrega := FTaxaEntrega
  else
    LEntrega := 0;

  LTotal := LSubtotal + LEntrega;

  lblSubtotal.Text :=
    FormatFloat('R$ #,##0.00', LSubtotal);

  lblEntregaValor.Text :=
    FormatFloat('R$ #,##0.00', LEntrega);

  lblTotal.Text :=
    FormatFloat('R$ #,##0.00', LTotal);
end;

function TfraFinalizarPedido.TextoFormaPagamento: string;
begin
  Result := '';

  if cboFormaPagamento.ItemIndex >= 0 then
    Result :=
      cboFormaPagamento.Items[
        cboFormaPagamento.ItemIndex
      ];
end;

function TfraFinalizarPedido.ConverterTextoCurrency(
  const ATexto: string;
  out AValor: Currency): Boolean;
var
  LTexto: string;
  LFormatSettings: TFormatSettings;
begin
  AValor := 0;

  LTexto := Trim(ATexto);

  if LTexto = '' then
  begin
    Result := False;
    Exit;
  end;

  LTexto := StringReplace(
    LTexto,
    'R$',
    '',
    [rfReplaceAll, rfIgnoreCase]
  );

  LTexto := Trim(LTexto);

  LFormatSettings := TFormatSettings.Create;
  Result := TryStrToCurr(
    LTexto,
    AValor,
    LFormatSettings
  );

  if Result then
    Exit;

  LTexto := StringReplace(
    LTexto,
    '.',
    '',
    [rfReplaceAll]
  );

  LTexto := StringReplace(
    LTexto,
    ',',
    LFormatSettings.DecimalSeparator,
    [rfReplaceAll]
  );

  Result := TryStrToCurr(
    LTexto,
    AValor,
    LFormatSettings
  );
end;

function TfraFinalizarPedido.ValidarCampos: Boolean;
var
  LValorTroco: Currency;
  LTotal: Currency;
begin
  Result := False;

  if Trim(edtNome.Text) = '' then
  begin
    ShowMessage('Informe o nome do cliente.');
    edtNome.SetFocus;
    Exit;
  end;

  if Trim(edtTelefone.Text) = '' then
  begin
    ShowMessage('Informe o telefone ou WhatsApp.');
    edtTelefone.SetFocus;
    Exit;
  end;

  if FTipoRecebimento = trEntrega then
  begin
    if Trim(edtCep.Text) = '' then
    begin
      ShowMessage('Informe o CEP.');
      edtCep.SetFocus;
      Exit;
    end;

    if Trim(edtEndereco.Text) = '' then
    begin
      ShowMessage('Informe a rua ou avenida.');
      edtEndereco.SetFocus;
      Exit;
    end;

    if Trim(edtNumero.Text) = '' then
    begin
      ShowMessage('Informe o número do endereço.');
      edtNumero.SetFocus;
      Exit;
    end;

    if Trim(edtBairro.Text) = '' then
    begin
      ShowMessage('Informe o bairro.');
      edtBairro.SetFocus;
      Exit;
    end;
  end;

  if cboFormaPagamento.ItemIndex < 0 then
  begin
    ShowMessage('Selecione a forma de pagamento.');
    cboFormaPagamento.SetFocus;
    Exit;
  end;

  if SameText(TextoFormaPagamento, 'Dinheiro') and
     (Trim(edtValorTroco.Text) <> '') then
  begin
    if not ConverterTextoCurrency(
      edtValorTroco.Text,
      LValorTroco
    ) then
    begin
      ShowMessage('Informe um valor válido para o troco.');
      edtValorTroco.SetFocus;
      Exit;
    end;

    LTotal := TCarrinho.Instancia.ValorTotal;

    if FTipoRecebimento = trEntrega then
      LTotal := LTotal + FTaxaEntrega;

    if LValorTroco < LTotal then
    begin
      ShowMessage(
        'O valor informado para o troco deve ser maior ou igual ao total do pedido.'
      );

      edtValorTroco.SetFocus;
      Exit;
    end;
  end;

  if TCarrinho.Instancia.QuantidadeItens = 0 then
  begin
    ShowMessage('O carrinho está vazio.');
    Exit;
  end;

  Result := True;
end;

function TfraFinalizarPedido.CriarDadosPedido:
  TDadosFinalizacaoPedido;
var
  LValorTroco: Currency;
begin
  Result := TDadosFinalizacaoPedido.Create;

  Result.Nome := Trim(edtNome.Text);
  Result.Telefone := Trim(edtTelefone.Text);

  Result.TipoRecebimento :=
    FTipoRecebimento;

  if FTipoRecebimento = trEntrega then
  begin
    Result.Cep := Trim(edtCep.Text);
    Result.Endereco := Trim(edtEndereco.Text);
    Result.Numero := Trim(edtNumero.Text);
    Result.Complemento := Trim(edtComplemento.Text);
    Result.Bairro := Trim(edtBairro.Text);
    Result.Referencia := Trim(edtReferencia.Text);
  end;

  Result.FormaPagamento :=
    TextoFormaPagamento;

  Result.ValorTroco := 0;

  if SameText(Result.FormaPagamento, 'Dinheiro') and
     ConverterTextoCurrency(
       edtValorTroco.Text,
       LValorTroco
     ) then
    Result.ValorTroco := LValorTroco;

  Result.Observacao :=
    Trim(memObservacao.Text);

  Result.Subtotal :=
    TCarrinho.Instancia.ValorTotal;

  if FTipoRecebimento = trEntrega then
    Result.TaxaEntrega := FTaxaEntrega
  else
    Result.TaxaEntrega := 0;

  Result.Total :=
    Result.Subtotal +
    Result.TaxaEntrega;
end;

procedure TfraFinalizarPedido.rctVoltarClick(
  Sender: TObject);
begin
  if Assigned(FOnVoltar) then
    FOnVoltar(Self);
end;

procedure TfraFinalizarPedido.rctEntregaClick(
  Sender: TObject);
begin
  SelecionarTipoRecebimento(trEntrega);
end;

procedure TfraFinalizarPedido.rctRetiradaClick(
  Sender: TObject);
begin
  SelecionarTipoRecebimento(trRetirada);
end;

procedure TfraFinalizarPedido.cboFormaPagamentoChange(
  Sender: TObject);
begin
  AtualizarFormaPagamento;
end;

procedure TfraFinalizarPedido.rctConfirmarClick(
  Sender: TObject);
var
  LDados: TDadosFinalizacaoPedido;
begin
  if not ValidarCampos then
    Exit;

  SalvarDadosCliente;

  LDados := CriarDadosPedido;

  try
    if Assigned(FOnPedidoConfirmado) then
      FOnPedidoConfirmado(Self, LDados)
    else
      ShowMessage(
        'Pedido validado com sucesso.' + sLineBreak +
        'Total: ' +
        FormatFloat('R$ #,##0.00', LDados.Total)
      );
  finally
    LDados.Free;
  end;
end;

procedure TfraFinalizarPedido.AjustarLayout;
begin
  rctConfirmar.Width :=
    rctRodape.Width - 36;

  rctSeparador.Width :=
    rctRodape.Width - 36;

  lblSubtotal.Width :=
    rctRodape.Width - 218;

  lblEntregaValor.Width :=
    rctRodape.Width - 218;

  lblTotal.Width :=
    rctRodape.Width - 198;

  lblTitulo.Width :=
    rctTopo.Width - 90;

  lblSubtitulo.Width :=
    rctTopo.Width - 90;
end;

procedure TfraFinalizarPedido.FrameResize(
  Sender: TObject);
begin
  AjustarLayout;
end;

procedure TfraFinalizarPedido.CarregarDadosClienteLocal;
var
  LCliente: TClienteLocal;
begin
  LCliente := TClienteLocal.Create;

  try
    LCliente.Carregar;

    if not LCliente.ExisteCadastro then
      Exit;

    edtNome.Text := LCliente.Nome;
    edtTelefone.Text := LCliente.Telefone;

    edtCep.Text := LCliente.Cep;
    edtEndereco.Text := LCliente.Endereco;
    edtNumero.Text := LCliente.Numero;
    edtComplemento.Text := LCliente.Complemento;
    edtBairro.Text := LCliente.Bairro;
    edtReferencia.Text := LCliente.Referencia;

  finally
    LCliente.Free;
  end;
end;

procedure TfraFinalizarPedido.SalvarDadosClienteLocal;
var
  LCliente: TClienteLocal;
begin
  LCliente := TClienteLocal.Create;

  try
    LCliente.Nome := Trim(edtNome.Text);
    LCliente.Telefone := Trim(edtTelefone.Text);

    LCliente.Cep := Trim(edtCep.Text);
    LCliente.Endereco := Trim(edtEndereco.Text);
    LCliente.Numero := Trim(edtNumero.Text);
    LCliente.Complemento := Trim(edtComplemento.Text);
    LCliente.Bairro := Trim(edtBairro.Text);
    LCliente.Referencia := Trim(edtReferencia.Text);

    LCliente.Salvar;

  finally
    LCliente.Free;
  end;
end;

procedure TfraFinalizarPedido.SalvarDadosCliente;
var
  LCliente: TClienteLocal;
begin
  LCliente := TClienteLocal.Create;

  try
    LCliente.Nome :=
      Trim(edtNome.Text);

    LCliente.Telefone :=
      Trim(edtTelefone.Text);

    LCliente.Cep :=
      Trim(edtCep.Text);

    LCliente.Endereco :=
      Trim(edtEndereco.Text);

    LCliente.Numero :=
      Trim(edtNumero.Text);

    LCliente.Bairro :=
      Trim(edtBairro.Text);

    LCliente.Complemento :=
      Trim(edtComplemento.Text);

    LCliente.Salvar;

  finally
    LCliente.Free;
  end;
end;

end.
