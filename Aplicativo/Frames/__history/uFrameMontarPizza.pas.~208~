procedure TfraMontarPizza.CarregarOpcoesProdutoAPI;
var
  LHTTP: TNetHTTPClient;
  LResposta: IHTTPResponse;
  LJSON: TJSONObject;

  LVariacoes: TJSONArray;
  LVariacao: TJSONObject;

  LSabores: TJSONArray;
  LSaborJSON: TJSONObject;
  LSabor: TSaborPizza;

  I: Integer;

  LId: string;
  LNome: string;
  LPrecoTexto: string;
  LPreco: Currency;

  LSaborId: string;
  LSaborNome: string;

  LArrayBordas: TJSONArray;
  LItemBorda: TJSONValue;
  LBorda: TBordaPizza;

  LValorAdicionalTexto: string;
  LValorAdicional: Currency;

  LFS: TFormatSettings;
begin
  if FProdutoIdAtual.Trim.IsEmpty then
    Exit;

  LHTTP := TNetHTTPClient.Create(nil);
  LJSON := nil;

  try
    LHTTP.Accept := 'application/json';

    LResposta := LHTTP.Get(
      'http://127.0.0.1:3001/api/produtos/' +
      FProdutoIdAtual +
      '/opcoes'
    );

    if LResposta.StatusCode <> 200 then
      Exit;

    LJSON :=
      TJSONObject.ParseJSONValue(
        LResposta.ContentAsString(TEncoding.UTF8)
      ) as TJSONObject;

    if not Assigned(LJSON) then
      Exit;

    LVariacoes :=
      LJSON.GetValue<TJSONArray>('variacoes');

    LSabores :=
      LJSON.GetValue<TJSONArray>('sabores');

    LFS := TFormatSettings.Create;
    LFS.DecimalSeparator := '.';

    { ====================================================== }
    { VARIAÇÕES / TAMANHOS                                  }
    { ====================================================== }

    LimparTamanhos;

    if Assigned(LVariacoes) then
    begin
      for I := 0 to LVariacoes.Count - 1 do
      begin
        LVariacao :=
          LVariacoes.Items[I] as TJSONObject;

        LId :=
          LVariacao.GetValue<string>(
            'id',
            ''
          );

        LNome :=
          LVariacao.GetValue<string>(
            'nome',
            ''
          );

        LPrecoTexto :=
          LVariacao.GetValue<string>(
            'preco',
            '0'
          );

        if not TryStrToCurr(
          LPrecoTexto,
          LPreco,
          LFS
        ) then
          LPreco := 0;

        AdicionarTamanho(
          LId,
          LNome,
          LPreco,
          I
        );
      end;
    end;

    { ====================================================== }
    { SABORES                                               }
    { ====================================================== }

    FSabores.Clear;

    if Assigned(LSabores) then
    begin
      for I := 0 to LSabores.Count - 1 do
      begin
        LSaborJSON :=
          LSabores.Items[I] as TJSONObject;

        LSaborId :=
          LSaborJSON.GetValue<string>(
            'id',
            ''
          );

        LSaborNome :=
          LSaborJSON.GetValue<string>(
            'nome',
            ''
          );

        LValorAdicionalTexto :=
          LSaborJSON.GetValue<string>(
            'valor_adicional',
            '0'
          );

        if not TryStrToCurr(
          LValorAdicionalTexto,
          LValorAdicional,
          LFS
        ) then
          LValorAdicional := 0;

        LSabor := TSaborPizza.Create;

        LSabor.Id := LSaborId;
        LSabor.Descricao := LSaborNome;
        LSabor.Valor := LValorAdicional;
        LSabor.Selecionado := False;

        FSabores.Add(LSabor);
      end;
    end;

    { ====================================================== }
    { BORDAS                                                 }
    { ====================================================== }
    FBordas.Clear;

    { Sem borda não existe no banco.
      Ela representa borda_id = NULL. }

    LBorda := TBordaPizza.Create;
    LBorda.Id := '';
    LBorda.Descricao := 'Sem borda';
    LBorda.Valor := 0;
    LBorda.Selecionada := True;

    FBordas.Add(LBorda);

    LArrayBordas :=
      LJSON.GetValue<TJSONArray>('bordas');

    if Assigned(LArrayBordas) then
    begin
      for I := 0 to LArrayBordas.Count - 1 do
      begin
        LItemBorda := LArrayBordas.Items[I];
        LBorda := TBordaPizza.Create;
        LBorda.Id := LItemBorda.GetValue<string>('id', '');
        LBorda.Descricao := LItemBorda.GetValue<string>('nome', '');
        LBorda.Valor := StrToCurrDef(LItemBorda.GetValue<string>('valor', '0'), 0, TFormatSettings.Invariant);
        LBorda.Selecionada := False;
        FBordas.Add(LBorda);
      end;
    end;

    { Atualiza a lista visual dos sabores }
    MontarListaSabores;
    AtualizarVisualSabores;
    AtualizarContadorSabores;
    CriarCardsBordas;
    AtualizarVisualBordas;

  finally
    LJSON.Free;
    LHTTP.Free;
  end;
end;

