  lytSabores.DeleteChildren;

  for I := 0 to FSabores.Count - 1 do
  begin
    LSabor := FSabores[I];

    LCard := TRectangle.Create(lytSabores);
    LCard.Parent := lytSabores;

    LCard.Position.X := 0;
    LCard.Position.Y := I * (ALTURA_CARD + ESPACO);

    LCard.Width := lytSabores.Width;
    LCard.Height := ALTURA_CARD;

    LCard.Fill.Color := $FFFFFFFF;
    LCard.Stroke.Color := $FFE8EAF0;
    LCard.Stroke.Thickness := 1;

    LCard.XRadius := 14;
    LCard.YRadius := 14;

    LCard.TagString := LSabor.Id;

    LCard.Cursor := crHandPoint;
    LCard.OnClick := SaborClick;

    LNome := TLabel.Create(LCard);
    LNome.Parent := LCard;
    LNome.Name := '';

    LNome.Position.X := 14;
    LNome.Position.Y := 9;
    LNome.Width := LCard.Width - 80;
    LNome.Height := 24;
    LNome.Text := LSabor.Descricao;

    LValor := TLabel.Create(LCard);
    LValor.Parent := LCard;
    LValor.Name := 'lblSaborValor_' + IntToStr(I);

    LValor.Position.X := 14;
    LValor.Position.Y := 34;
    LValor.Width := LCard.Width - 80;
    LValor.Height := 20;

    LValor.Text := 'Escolha o tamanho';

    LValor.TextSettings.Font.Size := 11;
    LValor.TextSettings.FontColor := $FFFF4B0A;
    LValor.TextSettings.HorzAlign := TTextAlign.Leading;
    LValor.TextSettings.VertAlign := TTextAlign.Center;
    LValor.HitTest := False;

    LSelecao := TCircle.Create(LCard);
    LSelecao.Parent := LCard;
    LSelecao.Name := 'crlSabor_' + IntToStr(I);

    LSelecao.Position.X := LCard.Width - 46;
    LSelecao.Position.Y := 17;
    LSelecao.Width := 32;
    LSelecao.Height := 32;

    LSelecao.Fill.Color := $FFFFFFFF;
    LSelecao.Stroke.Color := $FFD8DAE2;
    LSelecao.Stroke.Thickness := 2;
    LSelecao.HitTest := False;

    LCheck := TLabel.Create(LSelecao);
    LCheck.Parent := LSelecao;
    LCheck.Name := 'lblSaborCheck_' + IntToStr(I);

    LCheck.Align := TAlignLayout.Client;
    LCheck.Text := '✓';
    LCheck.Visible := False;
    LCheck.TextSettings.Font.Size := 16;
    LCheck.TextSettings.Font.Style :=
      [TFontStyle.fsBold];
    LCheck.TextSettings.FontColor := TAlphaColorRec.White;
    LCheck.TextSettings.HorzAlign := TTextAlign.Center;
    LCheck.TextSettings.VertAlign := TTextAlign.Center;
    LCheck.HitTest := False;
  end;

  if FSabores.Count = 0 then
    lytSabores.Height := 0
  else
    lytSabores.Height :=
      FSabores.Count * (ALTURA_CARD + ESPACO);
end;

procedure TfraMontarPizza.CriarCardsBordas;
const
  ALTURA_CARD = 60;
  ESPACO = 8;
var
  I: Integer;
  LBorda: TBordaPizza;
  LCard: TRectangle;
  LNome: TLabel;
  LValor: TLabel;
  LSelecao: TCircle;
  LPonto: TCircle;
begin
  lytBordas.DeleteChildren;

  while lytBordas.ChildrenCount > 0 do
    lytBordas.Children[0].Free;

  for I := 0 to FBordas.Count - 1 do
  begin
    LBorda := FBordas[I];

    LCard := TRectangle.Create(lytBordas);
    LCard.Parent := lytBordas;

    LCard.Position.X := 0;
    LCard.Position.Y := I * (ALTURA_CARD + ESPACO);
    LCard.Width := lytBordas.Width;
    LCard.Height := ALTURA_CARD;

    LCard.Fill.Color := $FFFFFFFF;
    LCard.Stroke.Color := $FFE8EAF0;
    LCard.Stroke.Thickness := 1;
    LCard.XRadius := 14;
    LCard.YRadius := 14;

    LCard.TagString := LBorda.Id;
    LCard.Cursor := crHandPoint;
    LCard.OnClick := BordaClick;

    LNome := TLabel.Create(LCard);
    LNome.Parent := LCard;
    LNome.Name := 'lblBordaNome_' + IntToStr(I);

    LNome.Position.X := 14;
    LNome.Position.Y := 8;
    LNome.Width := LCard.Width - 90;
    LNome.Height := 22;

    LNome.Text := LBorda.Descricao;
    LNome.TextSettings.Font.Size := 13;
    LNome.TextSettings.Font.Style :=
      [TFontStyle.fsBold];
    LNome.TextSettings.FontColor := $FF202332;
    LNome.TextSettings.HorzAlign := TTextAlign.Leading;
    LNome.TextSettings.VertAlign := TTextAlign.Center;
    LNome.HitTest := False;

    LValor := TLabel.Create(LCard);
    LValor.Parent := LCard;
    LValor.Name := 'lblBordaValor_' + IntToStr(I);
    LValor.Position.X := 14;
    LValor.Position.Y := 31;
    LValor.Width := LCard.Width - 90;
    LValor.Height := 19;

    if LBorda.Valor = 0 then
      LValor.Text := 'Sem acréscimo'
    else
      LValor.Text :=
        '+ ' + FormatFloat('R$ #,##0.00', LBorda.Valor);

    LValor.TextSettings.Font.Size := 10;
    LValor.TextSettings.FontColor := $FF7B8190;
    LValor.TextSettings.HorzAlign := TTextAlign.Leading;
    LValor.TextSettings.VertAlign := TTextAlign.Center;
    LValor.HitTest := False;

    LSelecao := TCircle.Create(LCard);
    LSelecao.Parent := LCard;
    LSelecao.Name := 'cirBorda_' + IntToStr(I);

    LSelecao.Position.X := LCard.Width - 42;
    LSelecao.Position.Y := 16;
    LSelecao.Width := 28;
    LSelecao.Height := 28;

    LSelecao.Fill.Color := $FFFFFFFF;
    LSelecao.Stroke.Color := $FFD8DAE2;
    LSelecao.Stroke.Thickness := 2;
    LSelecao.HitTest := False;

    LPonto := TCircle.Create(LSelecao);
    LPonto.Parent := LSelecao;
    LPonto.Name := 'crlBordaPonto_' + IntToStr(I);

    LPonto.Align := TAlignLayout.Client;
    LPonto.Margins.Left := 6;
    LPonto.Margins.Top := 6;
    LPonto.Margins.Right := 6;
    LPonto.Margins.Bottom := 6;

    LPonto.Fill.Color := $FFFF4B0A;
    LPonto.Stroke.Kind := TBrushKind.None;
    LPonto.Visible := False;
    LPonto.HitTest := False;
  end;

  if FBordas.Count = 0 then
    lytBordas.Height := 0
