procedure TfraMontarPizza.TamanhoClick(Sender: TObject);
var
  LRct: TRectangle;
begin
  if not (Sender is TRectangle) then
    Exit;

  LRct := TRectangle(Sender);

  FVariacaoIdSelecionada := LRct.TagString;
  FVariacaoNomeSelecionada := LRct.Hint;
  FVariacaoPrecoSelecionado := LRct.TagFloat;
  if SameText(FVariacaoNomeSelecionada, 'Pequena') then
    FVariacaoMaximoSabores := 1
  else if SameText(FVariacaoNomeSelecionada, 'Média') then
    FVariacaoMaximoSabores := 2
  else if SameText(FVariacaoNomeSelecionada, 'Grande') then
    FVariacaoMaximoSabores := 3
  else
    FVariacaoMaximoSabores := 1;

  FRctTamanhoSelecionado := LRct;

  AtualizarVisualTamanhoSelecionado;

  lblTotal.Text :=
    FormatFloat(
      '"R$ " #,##0.00',
      FVariacaoPrecoSelecionado
    );
  AtualizarEstadoSabores;
end;

procedure TfraMontarPizza.SelecionarTamanho(
  const ATamanhoId: Integer);
var
  LTamanho: TTamanhoPizza;
  LSabor: TSaborPizza;
begin
  FTamanhoSelecionado := nil;

  for LTamanho in FTamanhos do
  begin
    if LTamanho.Id = ATamanhoId then
    begin
      FTamanhoSelecionado := LTamanho;
      Break;
    end;
  end;

  if not Assigned(FTamanhoSelecionado) then
    Exit;

  { Caso o novo tamanho aceite menos sabores do que os
    atualmente selecionados, limpamos os sabores. }

  if QuantidadeSaboresSelecionados >
     FTamanhoSelecionado.MaximoSabores then
  begin
    for LSabor in FSabores do
      LSabor.Selecionado := False;
  end;

  AtualizarVisualTamanhos;
  AtualizarPrecosSabores;
  AtualizarVisualSabores;
  AtualizarContadorSabores;
  AtualizarTotal;
end;

procedure TfraMontarPizza.AtualizarVisualTamanhos;
var
  I: Integer;
  LCard: TRectangle;
  LSelecionado: Boolean;
  J: Integer;
begin
  for I := 0 to flwTamanhos.ChildrenCount - 1 do
  begin
    if not (flwTamanhos.Children[I] is TRectangle) then
      Continue;

    LCard := TRectangle(flwTamanhos.Children[I]);

    LSelecionado :=
      Assigned(FTamanhoSelecionado) and
      (LCard.Tag = FTamanhoSelecionado.Id);

    if LSelecionado then
    begin
      LCard.Fill.Color := $FFFF4B0A;
      LCard.Stroke.Color := $FFFF4B0A;
    end
    else
    begin
      LCard.Fill.Color := $FFFFFFFF;
      LCard.Stroke.Color := $FFE8EAF0;
    end;

    for J := 0 to LCard.ChildrenCount - 1 do
    begin
      if LCard.Children[J] is TLabel then
      begin
        if LSelecionado then
          TLabel(LCard.Children[J]).TextSettings.FontColor :=
            TAlphaColorRec.White
        else if Pos(
          'Valor',
          TLabel(LCard.Children[J]).Name
        ) > 0 then
          TLabel(LCard.Children[J]).TextSettings.FontColor :=
            $FFFF4B0A
        else if Pos(
          'Limite',
          TLabel(LCard.Children[J]).Name
        ) > 0 then
          TLabel(LCard.Children[J]).TextSettings.FontColor :=
            $FF7B8190
        else
          TLabel(LCard.Children[J]).TextSettings.FontColor :=
            $FF202332;
      end;
    end;
  end;
end;

procedure TfraMontarPizza.SaborClick(Sender: TObject);
