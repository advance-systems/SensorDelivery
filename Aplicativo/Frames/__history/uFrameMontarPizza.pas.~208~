procedure TfraMontarPizza.AtualizarPrecosSabores;
var
  I: Integer;
  J: Integer;
  LCard: TRectangle;
  LLabel: TLabel;
  LSabor: TSaborPizza;
  LValor: Currency;
begin
  for I := 0 to lytSabores.ChildrenCount - 1 do
  begin
    if not (lytSabores.Children[I] is TRectangle) then
      Continue;

    LCard := TRectangle(lytSabores.Children[I]);

    for LSabor in FSabores do
    begin
      if LSabor.Id <> LCard.TagString then
        Continue;

      if Assigned(FTamanhoSelecionado) then
        LValor := LSabor.ObterValor(FTamanhoSelecionado.Id)
      else
        LValor := 0;

      for J := 0 to LCard.ChildrenCount - 1 do
      begin
        if not (LCard.Children[J] is TLabel) then
          Continue;

        LLabel := TLabel(LCard.Children[J]);

        if Pos('lblSaborValor_', LLabel.Name) = 1 then
        begin
          if Assigned(FTamanhoSelecionado) then
            LLabel.Text :=
              '+ ' + FormatFloat('R$ #,##0.00', LValor)
          else
            LLabel.Text := 'Escolha o tamanho';

          Break;
        end;
      end;

      Break;
    end;
  end;
end;

