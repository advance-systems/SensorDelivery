  end;

  TBordaPizza = class
  public
    Id: string;
    Descricao: string;
    Valor: Currency;
    Selecionada: Boolean;
  end;

  TfraMontarPizza = class(TFrame)
    rctTopo: TRectangle;
    rctVoltar: TRectangle;
    lblVoltar: TLabel;
    lblTitulo: TLabel;
    lblSubtitulo: TLabel;
    vsbConteudo: TVertScrollBox;
    rctImagemPizza: TRectangle;
    lblImagemPizza: TLabel;
    lblTituloTamanho: TLabel;
    lblDescricaoTamanho: TLabel;
    flwTamanhos: TFlowLayout;
    lblTituloSabores: TLabel;
    lblContadorSabores: TLabel;
    lytSabores: TLayout;
    lblTituloBordas: TLabel;
    lytBordas: TLayout;
    lblTituloObservacao: TLabel;
    rctObservacao: TRectangle;
    memObservacao: TMemo;
    rctRodape: TRectangle;
    lytQuantidade: TLayout;
    rctMenos: TRectangle;
    lblMenos: TLabel;
    lblQuantidade: TLabel;
    rctMais: TRectangle;
    lblMais: TLabel;
    lblTextoTotal: TLabel;
    lblTotal: TLabel;
    rctAdicionar: TRectangle;
    lblAdicionar: TLabel;
    procedure rctMenosClick(Sender: TObject);
    procedure rctMaisClick(Sender: TObject);
    procedure rctAdicionarClick(Sender: TObject);
    procedure rctVoltarClick(Sender: TObject);
    procedure FrameResize(Sender: TObject);
  private
    FTamanhos: TObjectList<TTamanhoPizza>;
    FSabores: TObjectList<TSaborPizza>;
    FBordas: TObjectList<TBordaPizza>;

    FTamanhoSelecionado: TTamanhoPizza;
    FBordaSelecionada: TBordaPizza;
    FQuantidade: Integer;
    FProdutoIdAtual: string;
    FProdutoNomeAtual: string;
    FProdutoDescricaoAtual: string;
    FProdutoPrecoAtual: Currency;
    FVariacaoIdSelecionada: string;
    FVariacaoNomeSelecionada: string;
    FVariacaoPrecoSelecionado: Currency;
    FRctTamanhoSelecionado: TRectangle;
    FVariacaoMaximoSabores: Integer;
    FSecaoTamanhosOculta: Boolean;

    FOnVoltar: TNotifyEvent;
    FOnAdicionado: TNotifyEvent;

    LArrayBordas: TJSONArray;
    LItemBorda: TJSONValue;
    LBorda: TBordaPizza;

    procedure CarregarDadosTemporarios;
    procedure CriarCardsTamanhos;
    procedure CriarCardsSabores;
    procedure CriarCardsBordas;
    procedure CarregarProdutoAPI;

    procedure TamanhoClick(Sender: TObject);
    procedure SaborClick(Sender: TObject);
    procedure BordaClick(Sender: TObject);

    procedure SelecionarTamanho(const ATamanhoId: Integer);
    procedure SelecionarSabor(const ASaborId: String);
    procedure SelecionarBorda(const ABordaId: string);
    procedure AtualizarVisualTamanhos;
    procedure AtualizarVisualSabores;
    procedure AtualizarVisualBordas;
    procedure AtualizarContadorSabores;
    procedure AtualizarTotal;
    procedure AjustarLarguraListas;
    procedure AtualizarPrecosSabores;
    procedure OcultarSecaoTamanhos;
    procedure AtualizarPosicoesMontarPizza;

    function QuantidadeSaboresSelecionados: Integer;
    function CalcularValorSabores: Currency;
    function CalcularValorUnitario: Currency;
    procedure LimparSelecao;
    procedure CarregarOpcoesProdutoAPI;
    procedure LimparTamanhos;
    procedure AdicionarTamanho(const AId: string; const ANome: string; const APreco: Currency; const AIndice: Integer);
    procedure AtualizarVisualTamanhoSelecionado;
    procedure AtualizarEstadoSabores;
    procedure MontarListaSabores;
    procedure SaborItemClick(Sender: TObject);
  public
    constructor Create(AOwner: TComponent); override;

    procedure PrepararTela;
    procedure CarregarProduto(const AProdutoId: string);
    procedure CarregarPizza(const AProdutoId: string; const AVariacaoId: string; const AVariacaoNome: string;
      const APreco: Currency);

    property OnVoltar: TNotifyEvent
      read FOnVoltar
      write FOnVoltar;

    property OnAdicionado: TNotifyEvent
      read FOnAdicionado
      write FOnAdicionado;

    destructor Destroy; override;
  end;

implementation

{$R *.fmx}

uses uCarrinhoModel;

constructor TSaborPizza.Create;
begin
  inherited;

  Id := '';
  Descricao := '';
  Valor := 0;
  Selecionado := False;

  FPrecos := TObjectList<TPrecoSaborTamanho>.Create(True);
  Selecionado := False;
end;

destructor TSaborPizza.Destroy;
begin
  FPrecos.Free;
  inherited;
end;

procedure TSaborPizza.AdicionarPreco(
  const ATamanhoId: Integer;
  const AValor: Currency);
var
  LPreco: TPrecoSaborTamanho;
begin
  LPreco := TPrecoSaborTamanho.Create;
  LPreco.TamanhoId := ATamanhoId;
  LPreco.Valor := AValor;

  FPrecos.Add(LPreco);
end;

function TSaborPizza.ObterValor(
  const ATamanhoId: Integer): Currency;
var
  LPreco: TPrecoSaborTamanho;
begin
  Result := 0;

  for LPreco in FPrecos do
  begin
    if LPreco.TamanhoId = ATamanhoId then
      Exit(LPreco.Valor);
  end;
end;

constructor TfraMontarPizza.Create(AOwner: TComponent);
begin
  inherited;

  FTamanhos := TObjectList<TTamanhoPizza>.Create(True);
  FSabores := TObjectList<TSaborPizza>.Create(True);
  FBordas := TObjectList<TBordaPizza>.Create(True);

  FTamanhoSelecionado := nil;
  FBordaSelecionada := nil;
  FQuantidade := 1;
  FVariacaoIdSelecionada := '';
  FVariacaoNomeSelecionada := '';
  FVariacaoPrecoSelecionado := 0;
  FRctTamanhoSelecionado := nil;
  FSecaoTamanhosOculta := False;

  CarregarDadosTemporarios;

  CriarCardsTamanhos;
  CriarCardsSabores;
  CriarCardsBordas;

  SelecionarBorda('');

  AtualizarVisualTamanhos;
  AtualizarVisualSabores;
  AtualizarContadorSabores;
  AtualizarTotal;
end;

destructor TfraMontarPizza.Destroy;
begin
  FBordas.Free;
  FSabores.Free;
  FTamanhos.Free;

  inherited;
end;

