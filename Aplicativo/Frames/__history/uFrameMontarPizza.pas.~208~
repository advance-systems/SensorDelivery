procedure TfraMontarPizza.SelecionarSabor(
  const ASaborId: string);
var
  LSabor: TSaborPizza;
begin
  if FVariacaoIdSelecionada.Trim.IsEmpty then
  begin
    ShowMessage(
      'Escolha primeiro o tamanho da pizza.'
    );
    Exit;
  end;

  for LSabor in FSabores do
  begin
    if LSabor.Id <> ASaborId then
      Continue;

    if LSabor.Selecionado then
    begin
      LSabor.Selecionado := False;
    end
    else
    begin
      if QuantidadeSaboresSelecionados >=
         FVariacaoMaximoSabores then
      begin
        ShowMessage(
          Format(
            'A pizza %s permite no máximo %d sabor(es).',
            [
              FVariacaoNomeSelecionada,
              FVariacaoMaximoSabores
            ]
          )
        );

        Exit;
      end;

      LSabor.Selecionado := True;
    end;

    Break;
  end;

  AtualizarVisualSabores;
  AtualizarContadorSabores;
  AtualizarTotal;
end;

procedure TfraMontarPizza.AtualizarVisualSabores;
var
  I: Integer;
  J: Integer;
  LRct: TRectangle;
  LBola: TCircle;
  LSabor: TSaborPizza;
begin
  for I := 0 to lytSabores.ChildrenCount - 1 do
  begin
    if not (lytSabores.Children[I] is TRectangle) then
      Continue;

    LRct :=
      TRectangle(
        lytSabores.Children[I]
      );

    LSabor := nil;

    for J := 0 to FSabores.Count - 1 do
    begin
      if FSabores[J].Id = LRct.TagString then
      begin
        LSabor := FSabores[J];
        Break;
      end;
    end;

    if not Assigned(LSabor) then
      Continue;

    if LSabor.Selecionado then
    begin
      LRct.Stroke.Color := $FF8C63FF;
      LRct.Stroke.Thickness := 2;
      LRct.Fill.Color := $FFF7F4FF;
    end
    else
    begin
      LRct.Stroke.Color := $FFE1E5EB;
      LRct.Stroke.Thickness := 1;
      LRct.Fill.Color := $FFFFFFFF;
    end;

    for J := 0 to LRct.ChildrenCount - 1 do
    begin
      if LRct.Children[J] is TCircle then
      begin
        LBola := TCircle(
          LRct.Children[J]
        );

        if LSabor.Selecionado then
        begin
          LBola.Fill.Color := $FF8C63FF;
          LBola.Stroke.Color := $FF8C63FF;
        end
        else
        begin
          LBola.Fill.Color := $FFFFFFFF;
          LBola.Stroke.Color := $FFD0D5DD;
        end;

        Break;
      end;
    end;
  end;
end;

