procedure TfraMontarPizza.rctAdicionarClick(Sender: TObject);
var
  LItem: TItemCarrinho;
  LSaborPizza: TSaborPizza;
  LSaborCarrinho: TSaborCarrinho;
begin
  if FVariacaoIdSelecionada.Trim.IsEmpty then
  begin
    ShowMessage('Selecione o tamanho da pizza.');
    Exit;
  end;

  if QuantidadeSaboresSelecionados = 0 then
  begin
    ShowMessage('Selecione pelo menos um sabor.');
    Exit;
  end;

  LItem := TItemCarrinho.Create;

  try
    LItem.ProdutoId := FProdutoIdAtual;

    LItem.ProdutoDescricao :=
      'Pizza ' + FVariacaoNomeSelecionada;

    LItem.TamanhoId :=
      FVariacaoIdSelecionada;

    LItem.TamanhoDescricao :=
      FVariacaoNomeSelecionada;

    LItem.ValorBase :=
      FVariacaoPrecoSelecionado;

    if Assigned(FBordaSelecionada) then
    begin
      LItem.BordaId := FBordaSelecionada.Id;
      LItem.BordaDescricao := FBordaSelecionada.Descricao;
      LItem.ValorBorda := FBordaSelecionada.Valor;
    end;

    LItem.Quantidade := FQuantidade;

    LItem.Observacao :=
      Trim(memObservacao.Text);

    for LSaborPizza in FSabores do
    begin
      if not LSaborPizza.Selecionado then
        Continue;

      LSaborCarrinho :=
        TSaborCarrinho.Create;

      LSaborCarrinho.Id :=
        LSaborPizza.Id;

      LSaborCarrinho.Descricao :=
        LSaborPizza.Descricao;

      LSaborCarrinho.Valor :=
        LSaborPizza.Valor;

      LItem.Sabores.Add(
        LSaborCarrinho
      );
    end;

    TCarrinho.Instancia.Adicionar(
      LItem
    );

    { O carrinho passa a ser proprietário do item }
    LItem := nil;

    if Assigned(FOnAdicionado) then
      FOnAdicionado(Self);

  finally
    LItem.Free;
  end;
end;

