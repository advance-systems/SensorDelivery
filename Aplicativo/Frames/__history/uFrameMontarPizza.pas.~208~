function TfraMontarPizza.QuantidadeSaboresSelecionados: Integer;
var
  LSabor: TSaborPizza;
begin
  Result := 0;

  for LSabor in FSabores do
    if LSabor.Selecionado then
      Inc(Result);
end;

function TfraMontarPizza.CalcularValorSabores: Currency;
var
  LSabor: TSaborPizza;
begin
  Result := 0;

  for LSabor in FSabores do
  begin
    if LSabor.Selecionado then
      Result := Result + LSabor.Valor;
  end;
end;

function TfraMontarPizza.CalcularValorUnitario: Currency;
begin
  { Valor inicial da pizza pelo tamanho }
  Result := FVariacaoPrecoSelecionado;

  { Sabores }
  Result := Result + CalcularValorSabores;

  { Borda }
  if Assigned(FBordaSelecionada) then
    Result := Result + FBordaSelecionada.Valor;
end;

procedure TfraMontarPizza.AtualizarTotal;
var
  LTotal: Currency;
begin
  LTotal := CalcularValorUnitario * FQuantidade;

  lblQuantidade.Text := FQuantidade.ToString;

  lblTotal.Text :=
    FormatFloat(
      '"R$ " #,##0.00',
      LTotal
    );
end;

procedure TfraMontarPizza.AtualizarContadorSabores;
var
  LSelecionados: Integer;
begin
  if not Assigned(FTamanhoSelecionado) then
  begin
    lblContadorSabores.Text :=
      'Selecione um tamanho primeiro';

    Exit;
  end;

  LSelecionados := QuantidadeSaboresSelecionados;

  lblContadorSabores.Text :=
    Format(
      '%d de %d sabores selecionados',
      [
        LSelecionados,
        FTamanhoSelecionado.MaximoSabores
      ]
    );
end;

procedure TfraMontarPizza.CriarCardsTamanhos;
const
  ESPACO = 8;
var
  I: Integer;
  LTamanho: TTamanhoPizza;
  LCard: TRectangle;
  LDescricao: TLabel;
  LValor: TLabel;
  LLimite: TLabel;
  LLargura: Single;
begin
  flwTamanhos.DeleteChildren;

  if FTamanhos.Count = 0 then
  begin
    flwTamanhos.Height := 0;
    Exit;
  end;

  LLargura :=
    (flwTamanhos.Width - ((FTamanhos.Count - 1) * ESPACO)) /
    FTamanhos.Count;

  if LLargura < 105 then
    LLargura := 105;

  for I := 0 to FTamanhos.Count - 1 do
  begin
    LTamanho := FTamanhos[I];

    LCard := TRectangle.Create(flwTamanhos);
    LCard.Parent := flwTamanhos;
    LCard.Width := LLargura;
    LCard.Height := 104;
    LCard.Margins.Left := 2;
    LCard.Margins.Top := 4;
    LCard.Margins.Right := 2;
    LCard.Margins.Bottom := 4;

    LCard.Fill.Color := $FFFFFFFF;
    LCard.Stroke.Color := $FFE8EAF0;
    LCard.Stroke.Thickness := 1;
    LCard.XRadius := 15;
    LCard.YRadius := 15;

    LCard.Tag := LTamanho.Id;
    LCard.Cursor := crHandPoint;
    LCard.OnClick := TamanhoClick;

    LDescricao := TLabel.Create(LCard);
    LDescricao.Parent := LCard;
    LDescricao.Name :=
      'lblTamanhoDescricao_' + LTamanho.Id.ToString;

    LDescricao.Position.X := 8;
    LDescricao.Position.Y := 10;
    LDescricao.Width := LCard.Width - 16;
    LDescricao.Height := 24;

    LDescricao.Text := LTamanho.Descricao;
    LDescricao.TextSettings.Font.Size := 14;
    LDescricao.TextSettings.Font.Style :=
      [TFontStyle.fsBold];
    LDescricao.TextSettings.FontColor := $FF202332;
    LDescricao.TextSettings.HorzAlign := TTextAlign.Center;
    LDescricao.TextSettings.VertAlign := TTextAlign.Center;
    LDescricao.HitTest := False;

    LValor := TLabel.Create(LCard);
    LValor.Parent := LCard;
    LValor.Name :=
      'lblTamanhoValor_' + LTamanho.Id.ToString;

    LValor.Position.X := 8;
    LValor.Position.Y := 38;
    LValor.Width := LCard.Width - 16;
    LValor.Height := 22;

    LValor.Text :=
      FormatFloat('Base R$ #,##0.00', LTamanho.ValorBase);

    LValor.TextSettings.Font.Size := 11;
    LValor.TextSettings.FontColor := $FFFF4B0A;
    LValor.TextSettings.HorzAlign := TTextAlign.Center;
    LValor.TextSettings.VertAlign := TTextAlign.Center;
    LValor.HitTest := False;

    LLimite := TLabel.Create(LCard);
    LLimite.Parent := LCard;
    LLimite.Name :=
      'lblTamanhoLimite_' + LTamanho.Id.ToString;

    LLimite.Position.X := 8;
    LLimite.Position.Y := 65;
    LLimite.Width := LCard.Width - 16;
    LLimite.Height := 28;

    if LTamanho.MaximoSabores = 1 then
      LLimite.Text := 'Até 1 sabor'
    else
      LLimite.Text :=
        Format('Até %d sabores', [LTamanho.MaximoSabores]);

    LLimite.TextSettings.Font.Size := 10;
    LLimite.TextSettings.FontColor := $FF7B8190;
    LLimite.TextSettings.HorzAlign := TTextAlign.Center;
    LLimite.TextSettings.VertAlign := TTextAlign.Center;
    LLimite.HitTest := False;
  end;

  flwTamanhos.Height := 112;
end;

