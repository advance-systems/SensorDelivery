procedure TfraMontarPizza.AtualizarVisualTamanhoSelecionado;
var
  I: Integer;
  LRct: TRectangle;
begin
  for I := 0 to flwTamanhos.ChildrenCount - 1 do
  begin
    if flwTamanhos.Children[I] is TRectangle then
    begin
      LRct := TRectangle(
        flwTamanhos.Children[I]
      );

      if LRct = FRctTamanhoSelecionado then
      begin
        LRct.Fill.Color := $FFF3EEFF;
        LRct.Stroke.Color := $FF8C63FF;
        LRct.Stroke.Thickness := 2;
      end
      else
      begin
        LRct.Fill.Color := $FFFFFFFF;
        LRct.Stroke.Color := $FFE1E5EB;
        LRct.Stroke.Thickness := 1;
      end;
    end;
  end;
end;

procedure TfraMontarPizza.AtualizarEstadoSabores;
begin
  if FVariacaoIdSelecionada.Trim.IsEmpty then
  begin
    lblContadorSabores.Text :=
      'Selecione um tamanho primeiro';

    Exit;
  end;

  lblContadorSabores.Text :=
    Format(
      'Escolha até %d sabor(es)',
      [FVariacaoMaximoSabores]
    );
end;

procedure TfraMontarPizza.CarregarPizza(
  const AProdutoId: string;
  const AVariacaoId: string;
  const AVariacaoNome: string;
  const APreco: Currency);
begin
  FQuantidade := 1;
  FBordaSelecionada := nil;
  memObservacao.Text := '';

  for var LSabor in FSabores do
    LSabor.Selecionado := False;

  FProdutoIdAtual := AProdutoId;

  FVariacaoIdSelecionada := AVariacaoId;
  FVariacaoNomeSelecionada := AVariacaoNome;
  FVariacaoPrecoSelecionado := APreco;

  FRctTamanhoSelecionado := nil;

  if SameText(AVariacaoNome, 'Pequena') then
    FVariacaoMaximoSabores := 1
  else if SameText(AVariacaoNome, 'Média') then
    FVariacaoMaximoSabores := 2
  else if SameText(AVariacaoNome, 'Grande') then
    FVariacaoMaximoSabores := 3
  else
    FVariacaoMaximoSabores := 1;

  { Dados básicos do produto }
  CarregarProdutoAPI;

  { IMPORTANTE:
    carrega sabores/adicionais/variações reais }
  CarregarOpcoesProdutoAPI;

  lblTitulo.Text :=
    'Pizza ' + AVariacaoNome;

  lblSubtitulo.Text :=
    Format(
      'Escolha até %d sabor(es)',
      [FVariacaoMaximoSabores]
    );

  lblTotal.Text :=
    FormatFloat(
      '"R$ " #,##0.00',
      FVariacaoPrecoSelecionado
    );

  OcultarSecaoTamanhos;

  AtualizarEstadoSabores;
  AtualizarVisualSabores;
  AtualizarVisualBordas;
  AtualizarContadorSabores;
  AtualizarTotal;
end;

procedure TfraMontarPizza.OcultarSecaoTamanhos;
var
  LDeslocamento: Single;
begin
  { Evita subir os componentes novamente
    ao abrir outra pizza }
  if FSecaoTamanhosOculta then
    Exit;

  LDeslocamento :=
    (flwTamanhos.Position.Y + flwTamanhos.Height) -
    lblTituloTamanho.Position.Y +
    12;

  lblTituloTamanho.Visible := False;
  lblDescricaoTamanho.Visible := False;
  flwTamanhos.Visible := False;

  { Sabores }
  lblTituloSabores.Position.Y :=
    lblTituloSabores.Position.Y - LDeslocamento;

  lblContadorSabores.Position.Y :=
    lblContadorSabores.Position.Y - LDeslocamento;

  lytSabores.Position.Y :=
    lytSabores.Position.Y - LDeslocamento;

  { Bordas }
  lblTituloBordas.Position.Y :=
    lblTituloBordas.Position.Y - LDeslocamento;

  lytBordas.Position.Y :=
    lytBordas.Position.Y - LDeslocamento;

  { Observação }
  lblTituloObservacao.Position.Y :=
    lblTituloObservacao.Position.Y - LDeslocamento;

  rctObservacao.Position.Y :=
    rctObservacao.Position.Y - LDeslocamento;

  FSecaoTamanhosOculta := True;
end;

procedure TfraMontarPizza.MontarListaSabores;
const
  ALTURA_ITEM = 64;
  ESPACO = 8;
var
  I: Integer;
  LSabor: TSaborPizza;
  LRct: TRectangle;
  LNome: TLabel;
  LValor: TLabel;
  LBola: TCircle;
begin
  { Limpa a lista visual antiga }
  while lytSabores.ChildrenCount > 0 do
    lytSabores.Children[0].Free;

  lytSabores.Height := 0;

  for I := 0 to FSabores.Count - 1 do
  begin
    LSabor := FSabores[I];

    LRct := TRectangle.Create(nil);
    LRct.Name := '';
    LRct.Parent := lytSabores;

    LRct.Align := TAlignLayout.None;
    LRct.Position.X := 0;
    LRct.Position.Y := I * (ALTURA_ITEM + ESPACO);

    LRct.Width := lytSabores.Width;
    LRct.Height := ALTURA_ITEM;

    LRct.Fill.Color := $FFFFFFFF;
    LRct.Stroke.Color := $FFE1E5EB;
    LRct.Stroke.Thickness := 1;

    LRct.XRadius := 14;
    LRct.YRadius := 14;

    LRct.TagString := LSabor.Id;

    LRct.OnClick := SaborItemClick;

    { Nome }
    LNome := TLabel.Create(nil);
    LNome.Name := '';
    LNome.Parent := LRct;

    LNome.Align := TAlignLayout.None;
    LNome.Position.X := 14;
    LNome.Position.Y := 10;

    LNome.Width := LRct.Width - 80;
    LNome.Height := 22;

    LNome.Text := LSabor.Descricao;

    LNome.StyledSettings := [];
    LNome.TextSettings.Font.Size := 10;
    LNome.TextSettings.FontColor := $FF1E2430;

    LNome.HitTest := False;

    { Valor adicional }
    LValor := TLabel.Create(nil);
    LValor.Name := '';
    LValor.Parent := LRct;

    LValor.Align := TAlignLayout.None;
    LValor.Position.X := 14;
    LValor.Position.Y := 34;

    LValor.Width := LRct.Width - 80;
    LValor.Height := 18;

    if LSabor.Valor > 0 then
      LValor.Text :=
        FormatFloat(
          '"+ R$ " #,##0.00',
          LSabor.Valor
        )
    else
      LValor.Text := 'Sem adicional';

    LValor.StyledSettings := [];
    LValor.TextSettings.Font.Size := 8;
    LValor.TextSettings.FontColor := $FF667085;

    LValor.HitTest := False;

    { Indicador de seleção }
    LBola := TCircle.Create(nil);
    LBola.Name := '';
    LBola.Parent := LRct;

    LBola.Align := TAlignLayout.None;

    LBola.Position.X := LRct.Width - 46;
    LBola.Position.Y := 16;

    LBola.Width := 32;
    LBola.Height := 32;

    LBola.Fill.Color := $FFFFFFFF;
    LBola.Stroke.Color := $FFD0D5DD;
    LBola.Stroke.Thickness := 2;

    LBola.HitTest := False;
  end;

  if FSabores.Count > 0 then
    lytSabores.Height :=
      (FSabores.Count * ALTURA_ITEM) +
      ((FSabores.Count - 1) * ESPACO);

  AtualizarPosicoesMontarPizza;
end;

procedure TfraMontarPizza.SaborItemClick(Sender: TObject);
begin
  if not (Sender is TRectangle) then
    Exit;

  SelecionarSabor(
    TRectangle(Sender).TagString
  );
end;

procedure TfraMontarPizza.AtualizarPosicoesMontarPizza;
const
  ESPACO = 18;
begin
  { Borda vem depois dos sabores }
  lblTituloBordas.Position.Y :=
    lytSabores.Position.Y +
    lytSabores.Height +
    ESPACO;

  lytBordas.Position.Y :=
    lblTituloBordas.Position.Y +
    lblTituloBordas.Height +
    8;

  { Observação vem depois das bordas }
  lblTituloObservacao.Position.Y :=
    lytBordas.Position.Y +
    lytBordas.Height +
    ESPACO;

  rctObservacao.Position.Y :=
    lblTituloObservacao.Position.Y +
    lblTituloObservacao.Height +
    8;

  { Aumenta o conteúdo rolável }
  vsbConteudo.Content.Height :=
    rctObservacao.Position.Y +
    rctObservacao.Height +
    110;
end;

end.
