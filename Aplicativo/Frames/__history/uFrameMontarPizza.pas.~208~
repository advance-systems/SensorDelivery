  private
    FPrecos: TObjectList<TPrecoSaborTamanho>;
  public
    Id: String;
    Descricao: string;
    Valor: Currency;
    Selecionado: Boolean;

    constructor Create;
    destructor Destroy; override;

    procedure AdicionarPreco(
      const ATamanhoId: Integer;
      const AValor: Currency
    );

    function ObterValor(
      const ATamanhoId: Integer
