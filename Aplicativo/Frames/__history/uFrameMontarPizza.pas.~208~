procedure TfraMontarPizza.CarregarProduto(
  const AProdutoId: string);
begin
  { Limpa a seleção do produto anterior }
  FVariacaoIdSelecionada := '';
  FVariacaoNomeSelecionada := '';
  FVariacaoPrecoSelecionado := 0;
  FVariacaoMaximoSabores := 0;
  FRctTamanhoSelecionado := nil;

  { Define o novo produto }
  FProdutoIdAtual := AProdutoId;

  { Carrega os dados }
  CarregarProdutoAPI;
  CarregarOpcoesProdutoAPI;

  { Atualiza o estado inicial dos sabores }
  AtualizarEstadoSabores;
end;

procedure TfraMontarPizza.CarregarProdutoAPI;
var
  LHTTP: TNetHTTPClient;
  LResposta: IHTTPResponse;
  LJSON: TJSONObject;
  LProduto: TJSONObject;

  LNome: string;
  LDescricao: string;
  LPrecoTexto: string;
  LPreco: Currency;

  LFS: TFormatSettings;
begin
  if FProdutoIdAtual.Trim.IsEmpty then
    Exit;

  LHTTP := TNetHTTPClient.Create(nil);
  LJSON := nil;

  try
    try
      LHTTP.Accept := 'application/json';
      LHTTP.ConnectionTimeout := 5000;
      LHTTP.ResponseTimeout := 10000;

      LResposta := LHTTP.Get(
        'http://127.0.0.1:3001/api/produtos/' +
        FProdutoIdAtual
      );

      if LResposta.StatusCode <> 200 then
        raise Exception.CreateFmt(
          'Erro ao carregar o produto. API retornou %d.',
          [LResposta.StatusCode]
        );

      LJSON :=
        TJSONObject.ParseJSONValue(
          LResposta.ContentAsString(TEncoding.UTF8)
        ) as TJSONObject;

      if not Assigned(LJSON) then
        raise Exception.Create(
          'A API retornou um JSON inválido.'
        );

      LProduto :=
        LJSON.GetValue<TJSONObject>('produto');

      if not Assigned(LProduto) then
        raise Exception.Create(
          'Produto não encontrado na resposta da API.'
        );

      LNome :=
        LProduto.GetValue<string>(
          'nome',
          ''
        );

      LDescricao :=
        LProduto.GetValue<string>(
          'descricao',
          ''
        );

      LPrecoTexto :=
        LProduto.GetValue<string>(
          'preco',
          '0'
        );

      LFS := TFormatSettings.Create;
      LFS.DecimalSeparator := '.';

      if not TryStrToCurr(
        LPrecoTexto,
        LPreco,
        LFS
      ) then
        LPreco := 0;

      FProdutoNomeAtual := LNome;
      FProdutoDescricaoAtual := LDescricao;
      FProdutoPrecoAtual := LPreco;

      lblTitulo.Text := LNome;
      lblTextoTotal.Text := 'Total';
      lblTotal.Text := FormatFloat('"R$ " #,##0.00', LPreco);
    except
      on E: Exception do
      begin
        ShowMessage(
          'Não foi possível carregar o produto.' +
          sLineBreak +
          sLineBreak +
          E.Message
        );
      end;
    end;
  finally
    LJSON.Free;
    LHTTP.Free;
  end;
end;

procedure TfraMontarPizza.LimparTamanhos;
var
  I: Integer;
begin
  for I := flwTamanhos.ChildrenCount - 1 downto 0 do
    flwTamanhos.Children[I].Free;
