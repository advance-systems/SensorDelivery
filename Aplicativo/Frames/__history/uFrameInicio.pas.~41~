unit uFrameInicio;

interface

uses
  System.SysUtils,
  System.Types,
  System.UITypes,
  System.Classes,
  System.Variants,
  System.Math,
  FMX.Types,
  FMX.Graphics,
  FMX.Controls,
  FMX.Forms,
  FMX.Dialogs,
  FMX.Layouts,
  FMX.Objects,
  FMX.StdCtrls,
  FMX.Edit,
  FMX.Controls.Presentation;

type
  TfraInicio = class(TFrame)
    vsbConteudo: TVertScrollBox;
    lytCabecalho: TLayout;
    crlLogo: TCircle;
    lblLogo: TLabel;
    lblNomeLoja: TLabel;
    lblStatusLoja: TLabel;
    rctBusca: TRectangle;
    lblIconeBusca: TLabel;
    edtBusca: TEdit;
    rctBanner: TRectangle;
    lblBannerTitulo: TLabel;
    lblBannerTexto: TLabel;
    rctBannerBotao: TRectangle;
    lblBannerBotao: TLabel;
    lblTituloCategorias: TLabel;
    hsbCategorias: THorzScrollBox;
    lblTituloDestaques: TLabel;
    flwProdutos: TFlowLayout;
    procedure edtBuscaTyping(Sender: TObject);
    procedure rctBannerBotaoClick(Sender: TObject);
    procedure FrameResize(Sender: TObject);
  private
    FCategoriaSelecionada: Integer;

    procedure CarregarDadosTemporarios;

    procedure CriarCategoria(
      const AId: Integer;
      const ANome: string;
      const AIcone: string
    );

    procedure CriarProduto(
      const AId: Integer;
      const ANome: string;
      const ADescricao: string;
      const AValor: Currency;
      const AIcone: string
    );

    procedure CategoriaClick(Sender: TObject);
    procedure ProdutoClick(Sender: TObject);

    procedure SelecionarCategoria(
      const ACategoriaId: Integer
    );

    procedure AtualizarLayoutProdutos;
    function CalcularLarguraCardProduto: Single;
  public
    constructor Create(AOwner: TComponent); override;
  end;

implementation

{$R *.fmx}

const
  COR_PRIMARIA: TAlphaColor = $FF6C5CE7;
  COR_PRIMARIA_CLARA: TAlphaColor = $FFF1EFFE;
  COR_CARD: TAlphaColor = $FFFFFFFF;
  COR_TEXTO: TAlphaColor = $FF202332;
  COR_TEXTO_SECUNDARIO: TAlphaColor = $FF7B8190;
  COR_BORDA: TAlphaColor = $FFE8EAF0;

constructor TfraInicio.Create(AOwner: TComponent);
begin
  inherited;

  FCategoriaSelecionada := 0;
  CarregarDadosTemporarios;
end;

