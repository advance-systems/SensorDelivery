unit uFramePedidoHistorico;

interface

uses
  System.SysUtils, System.Types, System.UITypes, System.Classes, System.Variants, 
  FMX.Types, FMX.Graphics, FMX.Controls, FMX.Forms, FMX.Dialogs, FMX.StdCtrls,
  FMX.Objects, FMX.Controls.Presentation, uHistoricoPedidoModel;

type
  TPedidoHistoricoEvent = procedure(
    Sender: TObject;
    APedido: TPedidoHistorico
  ) of object;

  TfraPedidoHistorico = class(TFrame)
    rctCartao: TRectangle;
    lblNumero: TLabel;
    lblData: TLabel;
    lblStatus: TLabel;
    lblItens: TLabel;
    lblTotal: TLabel;
    rctAcao: TRectangle;
    lblAcao: TLabel;
  private
    FPedido: TPedidoHistorico;
    FOnAcao: TPedidoHistoricoEvent;

    procedure rctAcaoClick(Sender: TObject);
    function FormatarData(const AData: string): string;
    function MontarResumoItens(APedido: TPedidoHistorico): string;
  public
    procedure Configurar(APedido: TPedidoHistorico);

    property OnAcao: TPedidoHistoricoEvent
      read FOnAcao
      write FOnAcao;
  end;

implementation

{$R *.fmx}

function TfraPedidoHistorico.FormatarData(
  const AData: string): string;
begin
  Result := AData;

  if Length(AData) >= 10 then
    Result :=
      Copy(AData, 9, 2) + '/' +
      Copy(AData, 6, 2) + '/' +
      Copy(AData, 1, 4);
end;

function TfraPedidoHistorico.MontarResumoItens(
  APedido: TPedidoHistorico): string;
var
  LItem: TItemHistoricoPedido;
  LDescricao: string;
begin
  Result := '';

  if not Assigned(APedido) then
    Exit;

  for LItem in APedido.Itens do
  begin
    if not Result.IsEmpty then
      Result := Result + sLineBreak;

    LDescricao :=
      LItem.Quantidade.ToString +
      'x ' +
      LItem.ProdutoDescricao;

    if not LItem.TamanhoDescricao.Trim.IsEmpty then
      LDescricao :=
        LDescricao +
        ' - ' +
        LItem.TamanhoDescricao;

    Result := Result + LDescricao;
  end;

  if Result.IsEmpty then
    Result := 'Itens não informados';
end;

procedure TfraPedidoHistorico.Configurar(
  APedido: TPedidoHistorico);
begin
  FPedido := APedido;

  if not Assigned(FPedido) then
    Exit;

  lblNumero.Text :=
    'Pedido #' + FPedido.Numero.ToString;

  lblData.Text :=
    FormatarData(FPedido.CriadoEm);

  lblStatus.Text :=
    FPedido.StatusDescricao;

  lblItens.Text :=
    MontarResumoItens(FPedido);

  lblTotal.Text :=
    'Total: ' +
    FormatCurr(
      'R$ #,##0.00',
      FPedido.ValorTotal
    );

  rctAcao.OnClick := rctAcaoClick;

  if FPedido.EstaFinalizado then
  begin
    rctAcao.Visible := True;
    lblAcao.Text := 'Repetir pedido';
    lblStatus.TextSettings.FontColor :=
      $FF399B55;
  end
  else if FPedido.EstaEmAndamento then
  begin
    rctAcao.Visible := True;
    lblAcao.Text := 'Acompanhar';
    lblStatus.TextSettings.FontColor :=
      $FFFF4B12;
  end
  else
  begin
    rctAcao.Visible := False;
    lblStatus.TextSettings.FontColor :=
      $FF9999A3;
  end;
end;

procedure TfraPedidoHistorico.rctAcaoClick(
  Sender: TObject);
begin
  if Assigned(FOnAcao) and
     Assigned(FPedido) then
    FOnAcao(Self, FPedido);
end;

end.
