unit uHistoricoPedidoService;

interface

uses
  System.SysUtils,
  System.Classes,
  System.JSON,
  System.Generics.Collections,
  System.Net.URLClient,
  System.Net.HttpClient,
  System.NetEncoding,
  uHistoricoPedidoModel;

type
  THistoricoPedidoService = class
  private
    class function LerTexto(
      AJSON: TJSONObject;
      const ANome: string
    ): string; static;

    class function LerCurrency(
      AJSON: TJSONObject;
      const ANome: string
    ): Currency; static;

    class function LerInteiro(
      AJSON: TJSONObject;
      const ANome: string
    ): Integer; static;
  public
    class function Carregar(
      const AEmpresaId: string;
      const ATelefone: string;
      const ADias: Integer;
      ALista: TObjectList<TPedidoHistorico>;
      out AErro: string
    ): Boolean; static;
  end;

implementation

class function THistoricoPedidoService.LerTexto(
  AJSON: TJSONObject;
  const ANome: string): string;
var
  LValor: TJSONValue;
begin
  Result := '';

  if not Assigned(AJSON) then
    Exit;

  LValor := AJSON.GetValue(ANome);

  if Assigned(LValor) and
     not (LValor is TJSONNull) then
    Result := LValor.Value;
end;

class function THistoricoPedidoService.LerCurrency(
  AJSON: TJSONObject;
  const ANome: string): Currency;
var
  LTexto: string;
  LFormato: TFormatSettings;
begin
  Result := 0;

  LTexto := LerTexto(AJSON, ANome);

  if LTexto.Trim.IsEmpty then
    Exit;

  LFormato := TFormatSettings.Create;

  LTexto := StringReplace(
    LTexto,
    '.',
    LFormato.DecimalSeparator,
    [rfReplaceAll]
  );

  TryStrToCurr(
    LTexto,
    Result,
    LFormato
  );
end;

class function THistoricoPedidoService.LerInteiro(
  AJSON: TJSONObject;
  const ANome: string): Integer;
begin
  Result :=
    Round(
      LerCurrency(AJSON, ANome)
    );
end;

class function THistoricoPedidoService.Carregar(
  const AEmpresaId: string;
  const ATelefone: string;
  const ADias: Integer;
  ALista: TObjectList<TPedidoHistorico>;
  out AErro: string): Boolean;
var
  LHTTP: TNetHTTPClient;
  LResposta: IHTTPResponse;
  LURL: string;

  LJSON: TJSONObject;
  LPedidosJSON: TJSONArray;
  LPedidoJSON: TJSONObject;
  LItensJSON: TJSONArray;
  LItemJSON: TJSONObject;
  LSaboresJSON: TJSONArray;
  LSaborJSON: TJSONObject;

  LPedido: TPedidoHistorico;
  LItem: TItemHistoricoPedido;
  LSabor: TSaborHistoricoPedido;

  I: Integer;
  J: Integer;
  K: Integer;
begin
  Result := False;
  AErro := '';

  if not Assigned(ALista) then
  begin
    AErro := 'A lista de pedidos não foi informada.';
    Exit;
  end;

  ALista.Clear;

  if AEmpresaId.Trim.IsEmpty then
  begin
    AErro := 'A empresa não foi informada.';
    Exit;
  end;

  if ATelefone.Trim.IsEmpty then
  begin
    AErro :=
      'Informe o telefone na tela Minha conta.';
    Exit;
  end;

  LHTTP := TNetHTTPClient.Create(nil);
  LJSON := nil;

  try
    try
      LHTTP.Accept := 'application/json';
      LHTTP.ConnectionTimeout := 5000;
      LHTTP.ResponseTimeout := 15000;

      LURL :=
        'http://127.0.0.1:3001' +
        '/api/pedidos/historico' +
        '?empresaId=' +
        TNetEncoding.URL.Encode(
          AEmpresaId.Trim
        ) +
        '&telefone=' +
        TNetEncoding.URL.Encode(
          ATelefone.Trim
        ) +
        '&dias=' +
        ADias.ToString;

      LResposta := LHTTP.Get(LURL);

      if LResposta.StatusCode <> 200 then
      begin
        AErro :=
          'A API retornou o código ' +
          LResposta.StatusCode.ToString +
          '.' +
          sLineBreak +
          LResposta.ContentAsString(
            TEncoding.UTF8
          );

        Exit;
      end;

      LJSON :=
        TJSONObject.ParseJSONValue(
          LResposta.ContentAsString(
            TEncoding.UTF8
          )
        ) as TJSONObject;

      if not Assigned(LJSON) then
      begin
        AErro :=
          'A API retornou um JSON inválido.';
        Exit;
      end;

      LPedidosJSON :=
        LJSON.GetValue<TJSONArray>(
          'pedidos'
        );

      if not Assigned(LPedidosJSON) then
      begin
        Result := True;
        Exit;
      end;

      for I := 0 to LPedidosJSON.Count - 1 do
      begin
        LPedidoJSON :=
          LPedidosJSON.Items[I]
            as TJSONObject;

        LPedido := TPedidoHistorico.Create;

        try
          LPedido.Id :=
            LerTexto(LPedidoJSON, 'id');

          LPedido.Numero :=
            LerInteiro(LPedidoJSON, 'numero');

          LPedido.Status :=
            LerTexto(LPedidoJSON, 'status');

          LPedido.TipoAtendimento :=
            LerTexto(
              LPedidoJSON,
              'tipo_atendimento'
            );

          LPedido.Subtotal :=
            LerCurrency(
              LPedidoJSON,
              'subtotal'
            );

          LPedido.TaxaEntrega :=
            LerCurrency(
              LPedidoJSON,
              'taxa_entrega'
            );

          LPedido.Desconto :=
            LerCurrency(
              LPedidoJSON,
              'desconto'
            );

          LPedido.Acrescimo :=
            LerCurrency(
              LPedidoJSON,
              'acrescimo'
            );

          LPedido.ValorTotal :=
            LerCurrency(
              LPedidoJSON,
              'valor_total'
            );

          LPedido.Observacao :=
            LerTexto(
              LPedidoJSON,
              'observacoes'
            );

          LPedido.CriadoEm :=
            LerTexto(
              LPedidoJSON,
              'criado_em'
            );

          LItensJSON :=
            LPedidoJSON.GetValue<TJSONArray>(
              'itens'
            );

          if Assigned(LItensJSON) then
          begin
            for J := 0 to LItensJSON.Count - 1 do
            begin
              LItemJSON :=
                LItensJSON.Items[J]
                  as TJSONObject;

              LItem :=
                TItemHistoricoPedido.Create;

              LItem.Id :=
                LerTexto(LItemJSON, 'id');

              LItem.ProdutoId :=
                LerTexto(
                  LItemJSON,
                  'produto_id'
                );

              LItem.ProdutoDescricao :=
                LerTexto(
                  LItemJSON,
                  'produto_descricao'
                );

              LItem.TamanhoId :=
                LerTexto(
                  LItemJSON,
                  'tamanho_id'
                );

              LItem.TamanhoDescricao :=
                LerTexto(
                  LItemJSON,
                  'tamanho_descricao'
                );

              LItem.Quantidade :=
                LerInteiro(
                  LItemJSON,
                  'quantidade'
                );

              LItem.ValorUnitario :=
                LerCurrency(
                  LItemJSON,
                  'valor_unitario'
                );

              LItem.ValorTotal :=
                LerCurrency(
                  LItemJSON,
                  'valor_total'
                );

              LItem.Observacao :=
                LerTexto(
                  LItemJSON,
                  'observacoes'
                );

              LItem.BordaId :=
                LerTexto(
                  LItemJSON,
                  'borda_id'
                );

              LItem.BordaDescricao :=
                LerTexto(
                  LItemJSON,
                  'borda_descricao'
                );

              LItem.ValorBorda :=
                LerCurrency(
                  LItemJSON,
                  'valor_borda'
                );

              LSaboresJSON :=
                LItemJSON.GetValue<TJSONArray>(
                  'sabores'
                );

              if Assigned(LSaboresJSON) then
              begin
                for K :=
                  0 to LSaboresJSON.Count - 1 do
                begin
                  LSaborJSON :=
                    LSaboresJSON.Items[K]
                      as TJSONObject;

                  LSabor :=
                    TSaborHistoricoPedido.Create;

                  LSabor.Id :=
                    LerTexto(
                      LSaborJSON,
                      'id'
                    );

                  LSabor.Descricao :=
                    LerTexto(
                      LSaborJSON,
                      'descricao'
                    );

                  LSabor.Valor :=
                    LerCurrency(
                      LSaborJSON,
                      'valor'
                    );

                  LItem.Sabores.Add(LSabor);
                end;
              end;

              LPedido.Itens.Add(LItem);
            end;
          end;

          ALista.Add(LPedido);
          LPedido := nil;
        finally
          LPedido.Free;
        end;
      end;

      Result := True;

    except
      on E: Exception do
      begin
        AErro :=
          'Não foi possível carregar os pedidos.' +
          sLineBreak +
          E.Message;
      end;
    end;

  finally
    LJSON.Free;
    LResposta := nil;
    LHTTP.Free;
  end;
end;

end.
