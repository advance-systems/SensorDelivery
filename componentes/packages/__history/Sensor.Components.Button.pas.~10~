implementation

{ TSensorButton }

constructor TSensorButton.Create(AOwner: TComponent);
begin
  inherited Create(AOwner);

  Width := 220;
  Height := 48;

  Cursor := crHandPoint;
  HitTest := True;
  ClipChildren := False;

  FCaption := 'Sensor Button';
  FIcon := '';

  FSelected := False;
  FMouseOver := False;
  FMousePressed := False;

  FIconAreaWidth := 42;
  FIconSpacing := 8;

  FShowSelectedBar := True;
  FSelectedBarWidth := 4;

  FSelectedBorderThickness := 1;

  FTextFont := TFont.Create;
  FTextFont.Family := TSensorTheme.FontFamily;
  FTextFont.Size := 14;
  FTextFont.Style := [];
  FTextFont.OnChanged := TextFontChanged;

  FIconFont := TFont.Create;
  FIconFont.Family := TSensorTheme.IconFontFamily;
  FIconFont.Size := 20;
  FIconFont.Style := [];
  FIconFont.OnChanged := IconFontChanged;

  FSelectedBar := TRectangle.Create(Self);
  FSelectedBar.Parent := Self;
  FSelectedBar.Stored := False;
  FSelectedBar.HitTest := False;
  FSelectedBar.Align := TAlignLayout.Left;
  FSelectedBar.Width := FSelectedBarWidth;
  FSelectedBar.Fill.Kind := TBrushKind.Solid;
  FSelectedBar.Stroke.Kind := TBrushKind.None;
  FSelectedBar.XRadius := 2;
  FSelectedBar.YRadius := 2;
  FSelectedBar.Visible := False;

  FLabelIcone := TLabel.Create(Self);
  FLabelIcone.Parent := Self;
  FLabelIcone.Stored := False;
  FLabelIcone.HitTest := False;
  FLabelIcone.AutoSize := False;
  FLabelIcone.TextSettings.HorzAlign := TTextAlign.Center;
  FLabelIcone.TextSettings.VertAlign := TTextAlign.Center;
  FLabelIcone.TextSettings.WordWrap := False;

  FLabelTexto := TLabel.Create(Self);
  FLabelTexto.Parent := Self;
  FLabelTexto.Stored := False;
  FLabelTexto.HitTest := False;
  FLabelTexto.AutoSize := False;
  FLabelTexto.TextSettings.HorzAlign := TTextAlign.Leading;
  FLabelTexto.TextSettings.VertAlign := TTextAlign.Center;
  FLabelTexto.TextSettings.WordWrap := False;

  ApplyTheme;

  TextFontChanged(nil);
  IconFontChanged(nil);

  UpdateTextAndIcon;
  UpdateLayout;
  UpdateVisualState;
end;

destructor TSensorButton.Destroy;
begin
  FTextFont.Free;
  FIconFont.Free;

  inherited;
end;

procedure TSensorButton.ApplyTheme;
begin
  inherited;

  FTextColor := TSensorTheme.TextPrimary;
  FHoverTextColor := TSensorTheme.TextPrimary;
  FSelectedTextColor := TSensorTheme.TextPrimary;
  FDisabledTextColor := TSensorTheme.TextDisabled;

  FIconColor := TSensorTheme.TextSecondary;
  FHoverIconColor := TSensorTheme.TextPrimary;
  FSelectedIconColor := TSensorTheme.Primary;
  FDisabledIconColor := TSensorTheme.TextDisabled;

  FHoverBackgroundColor := TSensorTheme.SurfaceHover;
  FPressedBackgroundColor := TSensorTheme.SurfacePressed;
  FSelectedBackgroundColor := TSensorTheme.SurfaceHover;
  FDisabledBackgroundColor := TSensorTheme.SurfaceDisabled;

  FHoverBorderColor := TSensorTheme.BorderHover;
  FPressedBorderColor := TSensorTheme.BorderPressed;
  FSelectedBorderColor := TSensorTheme.Primary;
  FDisabledBorderColor := TSensorTheme.BorderDisabled;

  FSelectedBarColor := TSensorTheme.Primary;
end;

procedure TSensorButton.ApplyStyle;
begin
  inherited;
  UpdateVisualState;
end;

procedure TSensorButton.RefreshTheme;
begin
  inherited;

  if UseTheme then
  begin
    ApplyTheme;

    FTextFont.Family := TSensorTheme.FontFamily;
    FIconFont.Family := TSensorTheme.IconFontFamily;
  end;

  UpdateVisualState;
end;

procedure TSensorButton.UpdateVisualState;
var
  LBackgroundColor: TAlphaColor;
  LBorderColor: TAlphaColor;
  LTextColor: TAlphaColor;
  LIconColor: TAlphaColor;
  LBorderThickness: Single;
begin
  LBackgroundColor := BackgroundColor;
  LBorderColor := BorderColor;
  LTextColor := FTextColor;
  LIconColor := FIconColor;
  LBorderThickness := BorderThickness;

  if not Enabled then
  begin
    LBackgroundColor := FDisabledBackgroundColor;
    LBorderColor := FDisabledBorderColor;
    LTextColor := FDisabledTextColor;
    LIconColor := FDisabledIconColor;
  end
  else if FMousePressed then
  begin
    LBackgroundColor := FPressedBackgroundColor;
    LBorderColor := FPressedBorderColor;
    LTextColor := FHoverTextColor;
    LIconColor := FHoverIconColor;
  end
  else if FSelected then
  begin
    LBackgroundColor := FSelectedBackgroundColor;
    LBorderColor := FSelectedBorderColor;
    LTextColor := FSelectedTextColor;
    LIconColor := FSelectedIconColor;
    LBorderThickness := FSelectedBorderThickness;
  end
  else if FMouseOver then
  begin
    LBackgroundColor := FHoverBackgroundColor;
    LBorderColor := FHoverBorderColor;
    LTextColor := FHoverTextColor;
    LIconColor := FHoverIconColor;
  end;

  Fill.Kind := TBrushKind.Solid;
  Fill.Color := LBackgroundColor;

  if LBorderThickness <= 0 then
    Stroke.Kind := TBrushKind.None
  else
  begin
    Stroke.Kind := TBrushKind.Solid;
    Stroke.Color := LBorderColor;
    Stroke.Thickness := LBorderThickness;
  end;

  XRadius := CornerRadius;
  YRadius := CornerRadius;

  FLabelTexto.TextSettings.FontColor := LTextColor;
  FLabelIcone.TextSettings.FontColor := LIconColor;

  FSelectedBar.Fill.Color := FSelectedBarColor;
  FSelectedBar.Visible :=
    Enabled and
    FSelected and
    FShowSelectedBar and
    (FSelectedBarWidth > 0);

  Repaint;
end;

procedure TSensorButton.UpdateTextAndIcon;
begin
  FLabelTexto.Text := FCaption;
  FLabelIcone.Text := FIcon;

  FLabelIcone.Visible := FIcon <> '';

  UpdateLayout;
end;

procedure TSensorButton.UpdateLayout;
var
  LLeft: Single;
  LIconWidth: Single;
begin
  if not Assigned(FLabelTexto) or
     not Assigned(FLabelIcone) or
     not Assigned(FSelectedBar) then
    Exit;

  FSelectedBar.Width := FSelectedBarWidth;

  LLeft := 12;

  if FShowSelectedBar then
    LLeft := LLeft + FSelectedBarWidth;

  if FIcon <> '' then
  begin
    LIconWidth := FIconAreaWidth;

    FLabelIcone.SetBounds(
      LLeft,
      0,
      LIconWidth,
      Height
    );

    FLabelTexto.SetBounds(
      LLeft + LIconWidth + FIconSpacing,
      0,
      Max(
        0,
        Width - LLeft - LIconWidth - FIconSpacing - 12
      ),
      Height
    );
  end
  else
  begin
    FLabelIcone.SetBounds(0, 0, 0, Height);

    FLabelTexto.SetBounds(
      LLeft,
      0,
      Max(0, Width - LLeft - 12),
      Height
    );
  end;
end;

procedure TSensorButton.Resize;
begin
  inherited;
  UpdateLayout;
end;

procedure TSensorButton.DoMouseEnter;
begin
  inherited;

  FMouseOver := True;
  UpdateVisualState;
end;

procedure TSensorButton.DoMouseLeave;
begin
  inherited;

  FMouseOver := False;
  FMousePressed := False;

  UpdateVisualState;
end;

procedure TSensorButton.MouseDown(
  Button: TMouseButton;
  Shift: TShiftState;
  X, Y: Single);
begin
  inherited;

  if Enabled and (Button = TMouseButton.mbLeft) then
  begin
    FMousePressed := True;
    UpdateVisualState;
  end;
end;

procedure TSensorButton.MouseUp(
  Button: TMouseButton;
  Shift: TShiftState;
  X, Y: Single);
begin
  inherited;

  if Button = TMouseButton.mbLeft then
  begin
    FMousePressed := False;
    UpdateVisualState;
  end;
end;

procedure TSensorButton.EnabledChanged;
begin
  inherited;

  if not Enabled then
  begin
    FMouseOver := False;
    FMousePressed := False;
  end;

  UpdateVisualState;
end;

procedure TSensorButton.SetCaption(const Value: string);
begin
  if FCaption = Value then
    Exit;

  FCaption := Value;
  UpdateTextAndIcon;
end;

procedure TSensorButton.SetIcon(const Value: string);
begin
  if FIcon = Value then
    Exit;

  FIcon := Value;
  UpdateTextAndIcon;
end;

procedure TSensorButton.SetTextFont(const Value: TFont);
begin
  if Assigned(Value) then
    FTextFont.Assign(Value);
end;

procedure TSensorButton.SetIconFont(const Value: TFont);
begin
  if Assigned(Value) then
    FIconFont.Assign(Value);
end;

procedure TSensorButton.TextFontChanged(Sender: TObject);
begin
  if Assigned(FLabelTexto) then
  begin
    FLabelTexto.TextSettings.Font.Assign(FTextFont);
    FLabelTexto.Repaint;
  end;
end;

procedure TSensorButton.IconFontChanged(Sender: TObject);
begin
  if Assigned(FLabelIcone) then
  begin
    FLabelIcone.TextSettings.Font.Assign(FIconFont);
    FLabelIcone.Repaint;
  end;
end;

