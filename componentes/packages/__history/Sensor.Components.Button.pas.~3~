procedure TSensorButton.SetShowSelectedBar(const Value: Boolean);
begin
  FShowSelectedBar := Value;
  AtualizarAparencia;
end;

procedure TSensorButton.SetIconAreaWidth(const Value: Single);
begin
  if Value < 0 then
    FIconAreaWidth := 0
  else
    FIconAreaWidth := Value;

  AtualizarLayout;
end;

procedure TSensorButton.SetIconSpacing(const Value: Single);
begin
  if Value < 0 then
    FIconSpacing := 0
  else
    FIconSpacing := Value;

  AtualizarLayout;
end;

procedure TSensorButton.SetSelected(const Value: Boolean);
begin
  if FSelected <> Value then
  begin
    FSelected := Value;
    AtualizarAparencia;
  end;
end;

procedure Register;
begin
  RegisterComponents('Sensor Studio', [TSensorButton]);
end;

end.
