procedure TfraCentralPedidos.lytColunasKanbanResize(
  Sender: TObject);
var
  LAlturaColuna: Single;
begin
  lytColunasKanban.Height :=
    hsbKanban.Height;

  LAlturaColuna := Max(
    100,
    lytColunasKanban.Height - 9
  );

  rctColunaNovos.Height :=
    LAlturaColuna;

  rctColunaConfirmados.Height :=
    LAlturaColuna;

  rctColunaEmPreparo.Height :=
    LAlturaColuna;

  rctColunaProntos.Height :=
    LAlturaColuna;

  rctColunaEmEntrega.Height :=
    LAlturaColuna;
end;

procedure TfraCentralPedidos.ColunaMouseWheel(
  Sender: TObject;
  Shift: TShiftState;
  WheelDelta: Integer;
  var Handled: Boolean);
var
  LScroll: TVertScrollBox;
  LPosicaoY: Single;
  LMaximoY: Single;
begin
  if not (Sender is TVertScrollBox) then
    Exit;

  LScroll := TVertScrollBox(Sender);

  LMaximoY := Max(
    0,
    LScroll.Content.Height -
    LScroll.Height
  );

  LPosicaoY :=
    LScroll.ViewportPosition.Y -
    (WheelDelta / 2);

  LPosicaoY := EnsureRange(
    LPosicaoY,
    0,
    LMaximoY
  );

  LScroll.ViewportPosition := PointF(
    LScroll.ViewportPosition.X,
    LPosicaoY
  );

  Handled := True;
end;

procedure TfraCentralPedidos.AtualizarAlturaColuna(
  const AScroll: TVertScrollBox);
var
  I: Integer;
  LControle: TControl;
  LAltura: Single;
begin
  if not Assigned(AScroll) then
    Exit;

  LAltura := 0;

  for I := 0 to AScroll.Content.ChildrenCount - 1 do
  begin
    if AScroll.Content.Children[I] is TfraPedidoKanban then
    begin
      LControle :=
        TControl(AScroll.Content.Children[I]);

      LAltura := Max(
        LAltura,
        LControle.Position.Y +
        LControle.Height +
        10
      );
    end;
  end;

  AScroll.Content.Height := Max(
    AScroll.Height,
    LAltura
  );
end;

