function TfraCentralPedidos.AtualizarStatusPedidoAPI(
  const APedidoId: string;
  const AStatus: TStatusPedidoKanban;
  out AErro: string
): Boolean;
var
  LHTTP: TNetHTTPClient;
  LResposta: IHTTPResponse;
  LJSON: TJSONObject;
  LStream: TStringStream;
  LStatusAPI: string;
  LURL: string;
begin
  Result := False;
  AErro := '';

  if APedidoId.Trim.IsEmpty then
  begin
    AErro := 'O pedido não possui um identificador válido.';
    Exit;
  end;

  case AStatus of
    spNovo:
      LStatusAPI := 'RASCUNHO';

    spConfirmado:
      LStatusAPI := 'CONFIRMADO';

    spEmPreparo:
      LStatusAPI := 'EM_PREPARO';

    spPronto:
      LStatusAPI := 'PRONTO';

    spEmEntrega:
      LStatusAPI := 'SAIU_PARA_ENTREGA';

    spFinalizado:
      LStatusAPI := 'ENTREGUE';
  else
    begin
      AErro := 'Status de destino inválido.';
      Exit;
    end;
  end;

  LHTTP := TNetHTTPClient.Create(nil);
  LJSON := TJSONObject.Create;
  LStream := nil;
  LResposta := nil;

  try
    try
      LHTTP.Accept := 'application/json';
      LHTTP.ContentType := 'application/json';
      LHTTP.ConnectionTimeout := 5000;
      LHTTP.ResponseTimeout := 15000;

      LJSON.AddPair('status', LStatusAPI);

      LStream := TStringStream.Create(
        LJSON.ToJSON,
        TEncoding.UTF8
      );

      LURL :=
        'http://127.0.0.1:3001/api/pedidos/' +
        APedidoId +
        '/status';

      LResposta := LHTTP.Patch(LURL, LStream);

      if LResposta.StatusCode <> 200 then
      begin
        AErro :=
          'A API retornou o código ' +
          LResposta.StatusCode.ToString +
          '.' +
          sLineBreak +
          LResposta.ContentAsString(TEncoding.UTF8);

        Exit;
      end;

      Result := True;
    except
      on E: Exception do
        AErro :=
          'Não foi possível alterar o status.' +
          sLineBreak +
          E.Message;
    end;
  finally
    LResposta := nil;
    LStream.Free;
    LJSON.Free;
    LHTTP.Free;
  end;
end;

procedure TfraCentralPedidos.PedidoAvancarStatus(
  Sender: TObject;
  const APedidoId: string;
  const AStatusAtual: TStatusPedidoKanban);
var
  LFrame: TfraPedidoKanban;
  LProximoStatus: TStatusPedidoKanban;
  LConfirmado: Boolean;
  LErro: string;
begin
  if not (Sender is TfraPedidoKanban) then
    Exit;

  LFrame := TfraPedidoKanban(Sender);

  LProximoStatus := ProximoStatusPedido(
    AStatusAtual,
    LFrame.TipoEntrega
  );

  tmrCentralPedidos.Enabled := False;

  try
    LConfirmado := TfrmMensagem.Exibir(
      'Alterar status',
      'Deseja avançar o pedido para "' +
      DescricaoStatus(LProximoStatus) + '"?',
      tmConfirmacao,
      True,
      'Avançar',
      'Cancelar'
    );

    if not LConfirmado then
      Exit;

    if not AtualizarStatusPedidoAPI(
      APedidoId,
      LProximoStatus,
      LErro
    ) then
    begin
      TfrmMensagem.Exibir(
        'Não foi possível alterar o status',
        LErro,
        tmErro,
        False,
        'OK',
        ''
      );

      Exit;
    end;

    { Recarrega todas as colunas a partir do banco }
    CarregarPedidosCentralAPI;

    if LProximoStatus = spFinalizado then
      TfrmMensagem.Exibir(
        'Pedido finalizado',
        'O pedido foi finalizado com sucesso.',
        tmSucesso
      );

  finally
    tmrCentralPedidos.Enabled := True;
  end;
end;

