procedure TfraCentralPedidos.AdicionarCardTeste(
  const AContainer: TFmxObject;
  const APedidoId: string;
  const ANumero: string;
  const ACliente: string;
  const AHorario: TTime;
  const ATempoEspera: Integer;
  const AItens: string;
  const AObservacao: string;
  const ATotal: Currency;
  const ATipoEntrega: TTipoEntrega;
  const AStatus: TStatusPedidoKanban);
const
  ESPACO = 10;
var
  LFrame: TfraPedidoKanban;
  LDestinoReal: TFmxObject;
  LControle: TControl;
  LPosicaoY: Single;
  I: Integer;
begin
  if not Assigned(AContainer) then
    Exit;

  if AContainer is TVertScrollBox then
    LDestinoReal := TVertScrollBox(AContainer).Content
  else
    LDestinoReal := AContainer;

  LPosicaoY := 0;

  for I := 0 to LDestinoReal.ChildrenCount - 1 do
  begin
    if LDestinoReal.Children[I] is TfraPedidoKanban then
    begin
      LControle :=
        TControl(LDestinoReal.Children[I]);

      LPosicaoY := Max(
        LPosicaoY,
        LControle.Position.Y +
        LControle.Height +
        ESPACO
      );
    end;
  end;

  LFrame := TfraPedidoKanban.Create(LDestinoReal);

  LFrame.Name := '';
  LFrame.Parent := LDestinoReal;
  LFrame.Align := TAlignLayout.None;

  LFrame.Position.X := 0;
  LFrame.Position.Y := LPosicaoY;
  LFrame.Height := 218;

  if AContainer is TVertScrollBox then
    LFrame.Width :=
      TVertScrollBox(AContainer).Width -
      16
  else
    LFrame.Width := TControl(AContainer).Width;

  LFrame.Anchors := [
    TAnchorKind.akLeft,
    TAnchorKind.akTop
  ];

  LFrame.Preencher(
    APedidoId,
    ANumero,
    ACliente,
    AHorario,
    ATempoEspera,
    AItens,
    AObservacao,
    ATotal,
    ATipoEntrega,
    AStatus
  );

  LFrame.Height := 218;

  LFrame.OnAvancarStatus := PedidoAvancarStatus;
end;

procedure TfraCentralPedidos.CarregarPedidosCentralAPI;
var
  LHTTP: TNetHTTPClient;
  LResposta: IHTTPResponse;
  LJSON: TJSONObject;
  LPedidos: TJSONArray;
  LPedido: TJSONObject;
  LStatusTexto: string;
  LPedidoId: string;
  LNumero: Integer;
  LCliente: string;
  LItens: string;
  LObservacao: string;
  LTipoTexto: string;
  LDataTexto: string;
  LDataPedido: TDateTime;
  LHorario: TTime;
  LMinutos: Integer;
  LTotal: Currency;
  LStatus: TStatusPedidoKanban;
  LTipoEntrega: TTipoEntrega;
  LContainer: TFmxObject;
  LMaiorNumero: Integer;
  LMaiorCliente: string;
  LMaiorTotal: Currency;
  I: Integer;

  procedure LimparContainer(const AScroll: TVertScrollBox);
  begin
    if not Assigned(AScroll) then
      Exit;

    while AScroll.Content.ChildrenCount > 0 do
      AScroll.Content.Children[
        AScroll.Content.ChildrenCount - 1
      ].DisposeOf;
  end;

begin
  if FCarregandoCentral then
    Exit;

  FCarregandoCentral := True;
  LHTTP := TNetHTTPClient.Create(nil);
  LJSON := nil;

  try
    try
      LHTTP.Accept := 'application/json';

      LResposta := LHTTP.Get(
        'http://127.0.0.1:3001/api/pedidos'
      );

      if LResposta.StatusCode <> 200 then
        Exit;

      LJSON :=
        TJSONObject.ParseJSONValue(
          LResposta.ContentAsString(TEncoding.UTF8)
        ) as TJSONObject;

      if not Assigned(LJSON) then
        Exit;

      LPedidos := LJSON.GetValue<TJSONArray>('pedidos');

      if not Assigned(LPedidos) then
        Exit;

      LimparContainer(vsbPedidosNovos);
      LimparContainer(vsbPedidosConfirmados);
      LimparContainer(vsbPedidosEmPreparo);
      LimparContainer(vsbPedidosProntos);
      LimparContainer(vsbPedidosEmEntrega);

      LMaiorNumero := 0;
      LMaiorCliente := '';
      LMaiorTotal := 0;

      for I := 0 to LPedidos.Count - 1 do
      begin
        LPedido := LPedidos.Items[I] as TJSONObject;

        LPedidoId :=
          LPedido.GetValue<string>('id', '');

        LNumero :=
          StrToIntDef(
            LPedido.GetValue<string>('numero', '0'),
            0
          );

        LCliente :=
          LPedido.GetValue<string>('cliente_nome', '');

        LStatusTexto :=
          UpperCase(
            LPedido.GetValue<string>('status', '')
          );

        { Pedidos concluídos não aparecem na operação }
        if (LStatusTexto = 'ENTREGUE') or
           (LStatusTexto = 'FINALIZADO') or
           (LStatusTexto = 'CANCELADO') then
          Continue;

        if (LStatusTexto = 'RASCUNHO') or
           (LStatusTexto = 'AGUARDANDO_CONFIRMACAO') or
           (LStatusTexto = 'NOVO') then
          LStatus := spNovo
        else if LStatusTexto = 'CONFIRMADO' then
          LStatus := spConfirmado
        else if LStatusTexto = 'EM_PREPARO' then
          LStatus := spEmPreparo
        else if LStatusTexto = 'PRONTO' then
          LStatus := spPronto
        else if (LStatusTexto = 'SAIU_PARA_ENTREGA') or
                (LStatusTexto = 'EM_ENTREGA') or
                (LStatusTexto = 'SAIU_ENTREGA') then
          LStatus := spEmEntrega
        else
          Continue;

        LContainer := ObterContainerStatus(LStatus);

        if not Assigned(LContainer) then
          Continue;

        LTipoTexto :=
          UpperCase(
            LPedido.GetValue<string>(
              'tipo_atendimento',
              ''
            )
          );

        if LTipoTexto = 'RETIRADA' then
          LTipoEntrega := teRetirada
        else
          LTipoEntrega := teDelivery;

        LItens :=
          LPedido.GetValue<string>(
            'itens_resumo',
            ''
          );

        LObservacao :=
          LPedido.GetValue<string>(
            'observacoes',
            ''
          );

        LTotal :=
          StrToCurrDef(
            LPedido.GetValue<string>(
              'valor_total',
              '0'
            ),
            0,
            TFormatSettings.Invariant
          );

        LDataTexto :=
          LPedido.GetValue<string>(
            'criado_em',
            ''
          );

        if not TryISO8601ToDate(
          LDataTexto,
          LDataPedido,
          False
        ) then
          LDataPedido := Now;

        LHorario := TimeOf(LDataPedido);
        LMinutos := MinutesBetween(Now, LDataPedido);

        AdicionarCardTeste(
          LContainer,
          LPedidoId,
          'Pedido #' + LNumero.ToString,
          LCliente,
          LHorario,
          LMinutos,
          LItens,
          LObservacao,
          LTotal,
          LTipoEntrega,
          LStatus
        );

        if LNumero > LMaiorNumero then
        begin
          LMaiorNumero := LNumero;
          LMaiorCliente := LCliente;
          LMaiorTotal := LTotal;
        end;
      end;

      AtualizarAlturaColuna(vsbPedidosNovos);
      AtualizarAlturaColuna(vsbPedidosConfirmados);
      AtualizarAlturaColuna(vsbPedidosEmPreparo);
      AtualizarAlturaColuna(vsbPedidosProntos);
      AtualizarAlturaColuna(vsbPedidosEmEntrega);

      TControlAccess(vsbPedidosNovos.Content).Realign;
      TControlAccess(vsbPedidosConfirmados.Content).Realign;
      TControlAccess(vsbPedidosEmPreparo.Content).Realign;
      TControlAccess(vsbPedidosProntos.Content).Realign;
      TControlAccess(vsbPedidosEmEntrega.Content).Realign;

      AtualizarContadores;

      VerificarNovoPedidoCentral(
        LMaiorNumero,
        LMaiorCliente,
        LMaiorTotal
      );

    except
      on E: Exception do
      begin
        { O timer tentará novamente sem interromper o painel }
      end;
    end;
  finally
    LJSON.Free;
    LHTTP.Free;
    FCarregandoCentral := False;
  end;
end;

