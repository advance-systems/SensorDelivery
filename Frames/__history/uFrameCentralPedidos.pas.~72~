procedure TfraCentralPedidos.AtualizarBarraHorizontal;
var
  LAreaVisivel: Single;
  LAreaTotal: Single;
  LLarguraTrilho: Single;
  LLarguraIndicador: Single;
  LMaxScroll: Single;
  LMaxIndicador: Single;
  LPercentual: Single;
begin
  lytBarraHorizontal.Visible := False;
  Exit;

  LAreaVisivel := hsbKanban.Width;
  LAreaTotal := lytColunasKanban.Width;
  LLarguraTrilho := rctTrilhoHorizontal.Width;

  if (LAreaVisivel <= 0) or
     (LAreaTotal <= 0) or
     (LLarguraTrilho <= 0) then
    Exit;

  if LAreaTotal <= LAreaVisivel then
  begin
    lytBarraHorizontal.Visible := False;
    Exit;
  end;

  lytBarraHorizontal.Visible := True;

  LLarguraIndicador :=
    LLarguraTrilho *
    (LAreaVisivel / LAreaTotal);

  LLarguraIndicador := EnsureRange(
    LLarguraIndicador,
    80,
    LLarguraTrilho
  );

  rctIndicadorHorizontal.Width :=
    LLarguraIndicador;

  LMaxScroll :=
    LAreaTotal - LAreaVisivel;

  LMaxIndicador :=
    LLarguraTrilho - LLarguraIndicador;

  if (LMaxScroll <= 0) or
     (LMaxIndicador <= 0) then
  begin
    rctIndicadorHorizontal.Position.X := 0;
    Exit;
  end;

  LPercentual :=
    hsbKanban.ViewportPosition.X /
    LMaxScroll;

  LPercentual :=
    EnsureRange(LPercentual, 0, 1);

  rctIndicadorHorizontal.Position.X :=
    LMaxIndicador * LPercentual;
end;

procedure TfraCentralPedidos.AlertarNovoPedidoCentral(
  const ANumero: Integer;
  const ACliente: string;
  const ATotal: Currency);
begin
  TfrmMensagem.Exibir(
    'Novo Pedido',
    Format(
      'Pedido #%d' + sLineBreak +
      '%s' + sLineBreak +
      'Total: %s',
      [
        ANumero,
        ACliente,
        FormatFloat('"R$ " #,##0.00', ATotal)
      ]
    ),
    tmInformacao,
    False,
    'OK',
    ''
  );
end;

procedure TfraCentralPedidos.AplicarPosicaoIndicador(
  const AX: Single);
var
  LNovaPosicao: Single;
  LMaxIndicador: Single;
  LMaxScroll: Single;
  LPercentual: Single;
begin
  LMaxIndicador :=
    rctTrilhoHorizontal.Width -
    rctIndicadorHorizontal.Width;

  if LMaxIndicador <= 0 then
    Exit;

  LNovaPosicao := EnsureRange(
    AX,
    0,
    LMaxIndicador
  );

  rctIndicadorHorizontal.Position.X := LNovaPosicao;

  LMaxScroll :=
    lytColunasKanban.Width -
    hsbKanban.Width;

  if LMaxScroll <= 0 then
    Exit;

  LPercentual :=
    LNovaPosicao / LMaxIndicador;

  hsbKanban.ViewportPosition := PointF(
    LMaxScroll * LPercentual,
    hsbKanban.ViewportPosition.Y
  );
end;

procedure TfraCentralPedidos.MoverFrameParaContainer(
  const AFrame: TfraPedidoKanban;
  const AContainer: TFmxObject);
var
  LDestinoReal: TFmxObject;
begin
  if not Assigned(AFrame) then
    Exit;

  if not Assigned(AContainer) then
    Exit;

  if AContainer is TVertScrollBox then
    LDestinoReal := TVertScrollBox(AContainer).Content
  else
    LDestinoReal := AContainer;

  AFrame.Align := TAlignLayout.None;
  AFrame.Parent := LDestinoReal;

  AFrame.Align := TAlignLayout.Top;
  AFrame.Height := 218;

  AFrame.Margins.Left := 0;
  AFrame.Margins.Top := 0;
  AFrame.Margins.Right := 0;
  AFrame.Margins.Bottom := 10;

  AFrame.BringToFront;
end;

function TfraCentralPedidos.ProximoStatusPedido(
  const AStatusAtual: TStatusPedidoKanban;
  const ATipoEntrega: TTipoEntrega
): TStatusPedidoKanban;
begin
  case AStatusAtual of
    spNovo:
      Result := spConfirmado;

    spConfirmado:
      Result := spEmPreparo;

    spEmPreparo:
      Result := spPronto;

    spPronto:
      begin
        if ATipoEntrega = teDelivery then
          Result := spEmEntrega
        else
          Result := spFinalizado;
      end;

    spEmEntrega:
      Result := spFinalizado;

  else
    Result := spFinalizado;
  end;
end;

procedure TfraCentralPedidos.tmrCentralPedidosTimer(Sender: TObject);
begin
  if not Visible then
    Exit;

  CarregarPedidosCentralAPI;
end;

procedure TfraCentralPedidos.VerificarNovoPedidoCentral(
  const ANumero: Integer;
  const ACliente: string;
  const ATotal: Currency);
begin
  if ANumero <= 0 then
    Exit;

  if FPrimeiraCargaCentral then
  begin
    FUltimoNumeroPedidoCentral := ANumero;
    FPrimeiraCargaCentral := False;
    Exit;
  end;

  if ANumero <= FUltimoNumeroPedidoCentral then
    Exit;

  AlertarNovoPedidoCentral(
    ANumero,
    ACliente,
    ATotal
  );

  FUltimoNumeroPedidoCentral := ANumero;
end;

function TfraCentralPedidos.ObterContainerStatus(
  const AStatus: TStatusPedidoKanban
): TFmxObject;
begin
  case AStatus of
    spNovo:
      Result := vsbPedidosNovos;

    spConfirmado:
      Result := vsbPedidosConfirmados;

    spEmPreparo:
      Result := vsbPedidosEmPreparo;

    spPronto:
      Result := vsbPedidosProntos;

    spEmEntrega:
      Result := vsbPedidosEmEntrega;

  else
    Result := nil;
  end;
end;

function TfraCentralPedidos.DescricaoStatus(
  const AStatus: TStatusPedidoKanban
): string;
begin
  case AStatus of
    spNovo:
      Result := 'Novo';

    spConfirmado:
      Result := 'Confirmado';

    spEmPreparo:
      Result := 'Em preparo';

    spPronto:
      Result := 'Pronto';

    spEmEntrega:
      Result := 'Em entrega';

    spFinalizado:
      Result := 'Finalizado';

  else
    Result := '';
  end;
end;

