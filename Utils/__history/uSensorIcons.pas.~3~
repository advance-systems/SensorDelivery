class procedure TSensorIcon.Aplicar(
  const APath: TPath;
  const AData: string;
  const AColor: TAlphaColor;
  const AWidth: Single;
  const AHeight: Single);
begin
  if not Assigned(APath) then
    Exit;

  APath.Data.Data := AData;

  APath.Width := AWidth;
  APath.Height := AHeight;

  APath.WrapMode := TPathWrapMode.Stretch;

  APath.Fill.Kind := TBrushKind.Solid;
  APath.Fill.Color := AColor;

  APath.Stroke.Kind := TBrushKind.None;

  APath.HitTest := False;
end;

