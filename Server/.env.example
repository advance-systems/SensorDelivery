# Modelo Railway: um projeto, uma API e um PostgreSQL por cliente.
# Não copie este arquivo para produção sem substituir os valores ilustrativos.
NODE_ENV=production
HOST=0.0.0.0
# Railway fornece PORT automaticamente; 3001 é apenas o padrão local.
PORT=3001
DATABASE_URL=postgresql://usuario:SUA_SENHA@postgres.railway.internal:5432/railway
# Rede privada Railway: false. Conexões externas: configurar TLS conforme o servidor.
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_SSL_CA=
DB_POOL_MAX=5
DB_CONNECT_TIMEOUT_MS=5000
DB_STARTUP_ATTEMPTS=10
JWT_SECRET=troque-por-uma-chave-aleatoria-propria-de-32-caracteres-ou-mais
API_PUBLIC_URL=https://api-pizzaria-a.seudominio.com
HTTPS_ENABLED=false
TRUST_PROXY=true
CORS_ORIGIN=https://cardapio-pizzaria-a.seudominio.com,https://painel-pizzaria-a.seudominio.com
# Monte um volume Railway em /data. A plataforma fornece RAILWAY_VOLUME_MOUNT_PATH.
UPLOADS_DIR=/data/uploads
DOWNLOADS_DIR=/data/downloads
RUN_MIGRATIONS_ON_START=false
RUN_SEEDS_ON_START=false
IMPORT_MENU_ON_START=false
ALLOW_MENU_IMPORT=false
# Piloto: ativar somente após revisar os dados e integrações restaurados.
BACKGROUND_JOBS_ENABLED=false
DRAFT_CLEANUP_ENABLED=false
# Acesso mestre desabilitado. Use os usuários reais do banco da pizzaria.
ADMIN_MASTER_ENABLED=false
# ADMIN_MASTER_EMAIL=
# ADMIN_MASTER_SENHA=
# Integrações são individuais e opcionais. Começar pelo sandbox do Asaas.
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
# ASAAS_API_KEY=
# ASAAS_WEBHOOK_TOKEN=
# SICREDI_AUTH_URL=
# SICREDI_API_URL=
# SICREDI_CLIENT_ID=
# SICREDI_CLIENT_SECRET=
# Importação manual: caminho de arquivo autorizado, nunca automático.
# MENU_IMPORT_PATH=
