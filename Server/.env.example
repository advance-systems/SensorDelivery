DATABASE_URL=postgresql://postgres:SUA_SENHA@SEU_HOST_POSTGRES:5432/sensor_delivery
JWT_SECRET=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres
HOST=0.0.0.0
PORT=3001
API_PUBLIC_URL=https://api.seudominio.com
HTTPS_ENABLED=true
TLS_KEY_PATH=certificados/privkey.pem
TLS_CERT_PATH=certificados/fullchain.pem
# TLS_CA_PATH=certificados/chain.pem
# TLS_KEY_PASSPHRASE=
# TRUST_PROXY=true
NODE_ENV=production
DB_POOL_MAX=20
DATABASE_SSL=true
CORS_ORIGIN=*

# Integração PIX Asaas. Comece pelo Sandbox e troque a URL em produção.
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=$aact_SEU_TOKEN_ASAAS
# Token próprio, forte, entre 32 e 255 caracteres; não use a API Key.
ASAAS_WEBHOOK_TOKEN=troque-por-um-token-seguro-com-mais-de-32-caracteres

# Integração PIX Sicredi. Use as URLs entregues no processo de homologação.
SICREDI_AUTH_URL=https://api-pix.sicredi.com.br/oauth/token
SICREDI_API_URL=https://api-pix.sicredi.com.br/api/v3
SICREDI_CLIENT_ID=SEU_CLIENT_ID
SICREDI_CLIENT_SECRET=SEU_CLIENT_SECRET
