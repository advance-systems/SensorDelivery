implementation

{$R *.fmx}

uses uSessao;

function TfrmPrincipal.NovoBotaoMenu(const ATitulo: string; const AIcone: string; const AEvento: TNotifyEvent): TSensorButton;
begin
  Result := TSensorButton.Create(Self);
  Result.Parent := lytMenuBotoes;

  Result.Align := TAlignLayout.Top;
  Result.Height := 48;

  Result.Margins.Left := 18;
  Result.Margins.Top := 0;
  Result.Margins.Right := 18;
  Result.Margins.Bottom := 8;

  Result.Titulo := ATitulo;
  Result.Icone := AIcone;

  Result.IconFontFamily := 'Segoe MDL2 Assets';
  Result.IconFontSize := 22;

  Result.TextFontFamily := 'Urbanist';
  Result.TextFontSize := 14;

  Result.NormalColor := $FF191D27;
  Result.HoverColor := $FF242938;
  Result.PressedColor := $FF30364A;
  Result.SelectedColor := $FF292E40;
  Result.DisabledColor := $FF151820;

  Result.TextColor := $FFD6D9E3;
  Result.IconColor := $FFADB4C4;
  Result.SelectedTextColor := $FFFFFFFF;
  Result.SelectedIconColor := $FFFFFFFF;

  Result.BorderColor := $FF2E3445;
  Result.HoverBorderColor := $FF4B6BFF;
  Result.SelectedBorderColor := $FF7C5CFC;
  Result.DisabledBorderColor := $FF252A38;

  Result.BorderThickness := 1;
  Result.SelectedBorderThickness := 1;

  Result.ShowSelectedBar := True;
  Result.SelectedBarColor := $FF7C5CFC;
  Result.SelectedBarWidth := 4;

  Result.IconAreaWidth := 44;
  Result.IconSpacing := 4;

  Result.Selected := False;
  Result.OnClick := AEvento;
end;

procedure TfrmPrincipal.CriarMenu;
begin
  FBtnConfiguracoes := NovoBotaoMenu('Configurações', ICON_CONFIGURACOES, MenuConfiguracoesClick);
  FBtnUsuarios := NovoBotaoMenu('Usuários', ICON_USUARIOS, MenuUsuariosClick);
  FBtnWhatsApp := NovoBotaoMenu('WhatsApp', ICON_WHATSAPP, MenuWhatsAppClick);
  FBtnCategorias := NovoBotaoMenu('Categorias', ICON_CATEGORIAS, MenuCategoriasClick);
  FBtnProdutos := NovoBotaoMenu('Produtos', ICON_PRODUTOS, MenuProdutosClick);
  FBtnClientes := NovoBotaoMenu('Clientes', ICON_CLIENTES, MenuClientesClick);
  FBtnConversas := NovoBotaoMenu('Conversas', ICON_CONVERSAS, MenuConversasClick);
  FBtnPedidos := NovoBotaoMenu('Pedidos', ICON_PEDIDOS, MenuPedidosClick);
  FBtnDashboard := NovoBotaoMenu('Dashboard', ICON_DASHBOARD, MenuDashboardClick);
  SelecionarBotaoMenu(FBtnDashboard);
end;

