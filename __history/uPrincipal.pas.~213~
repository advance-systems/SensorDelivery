procedure TfrmPrincipal.SelecionarBotaoMenu(ABotao: TSensorButton);
begin
  FBtnDashboard.Selected := FBtnDashboard = ABotao;
  FBtnPedidos.Selected := FBtnPedidos = ABotao;
  FBtnConversas.Selected := FBtnConversas = ABotao;
  FBtnClientes.Selected := FBtnClientes = ABotao;
  FBtnProdutos.Selected := FBtnProdutos = ABotao;
  FBtnCategorias.Selected := FBtnCategorias = ABotao;
  FBtnWhatsApp.Selected := FBtnWhatsApp = ABotao;
  FBtnUsuarios.Selected := FBtnUsuarios = ABotao;
  FBtnConfiguracoes.Selected := FBtnConfiguracoes = ABotao;
end;

procedure TfrmPrincipal.FormClose(Sender: TObject; var Action: TCloseAction);
begin
