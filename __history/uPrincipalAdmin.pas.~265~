procedure TfrmPrincipalAdmin.AtualizarBarraHorizontal;
var
  LAreaVisivel: Single;
  LAreaTotal: Single;
  LLarguraTrilho: Single;
  LLarguraIndicador: Single;
  LMaxScroll: Single;
  LMaxIndicador: Single;
  LPercentual: Single;
begin
{  LAreaVisivel := hsbKanban.Width;
  LAreaTotal := lytColunasKanban.Width;
  LLarguraTrilho := rctTrilhoHorizontal.Width;

  if (LAreaVisivel <= 0) or
     (LAreaTotal <= 0) or
     (LLarguraTrilho <= 0) then
    Exit;

  if LAreaTotal <= LAreaVisivel then
  begin
    lytBarraHorizontal.Visible := False;
    Exit;
  end;

  lytBarraHorizontal.Visible := True;

  LLarguraIndicador :=
    LLarguraTrilho *
    (LAreaVisivel / LAreaTotal);

  LLarguraIndicador := EnsureRange(
    LLarguraIndicador,
    80,
    LLarguraTrilho
  );

  rctIndicadorHorizontal.Width :=
    LLarguraIndicador;

  LMaxScroll :=
    LAreaTotal - LAreaVisivel;

  LMaxIndicador :=
    LLarguraTrilho - LLarguraIndicador;

  if (LMaxScroll <= 0) or
     (LMaxIndicador <= 0) then
  begin
    rctIndicadorHorizontal.Position.X := 0;
    Exit;
  end;

  LPercentual :=
    hsbKanban.ViewportPosition.X /
    LMaxScroll;

  LPercentual :=
    EnsureRange(LPercentual, 0, 1);

  rctIndicadorHorizontal.Position.X :=
    LMaxIndicador * LPercentual;}
end;

procedure TfrmPrincipalAdmin.AplicarPosicaoIndicador(
  const AX: Single);
var
  LNovaPosicao: Single;
  LMaxIndicador: Single;
  LMaxScroll: Single;
  LPercentual: Single;
begin
{  LMaxIndicador :=
    rctTrilhoHorizontal.Width -
    rctIndicadorHorizontal.Width;

  if LMaxIndicador <= 0 then
    Exit;

  LNovaPosicao := EnsureRange(
    AX,
    0,
    LMaxIndicador
  );

  rctIndicadorHorizontal.Position.X := LNovaPosicao;

  LMaxScroll :=
    lytColunasKanban.Width -
    hsbKanban.Width;

  if LMaxScroll <= 0 then
    Exit;

  LPercentual :=
    LNovaPosicao / LMaxIndicador;

  hsbKanban.ViewportPosition := PointF(
    LMaxScroll * LPercentual,
    hsbKanban.ViewportPosition.Y
  );}
end;

