begin
  case AStatusAtual of
    spNovo:
      Result := spConfirmado;

    spConfirmado:
      Result := spEmPreparo;

    spEmPreparo:
      Result := spPronto;

    spPronto:
      begin
        if ATipoEntrega = teDelivery then
          Result := spEmEntrega
        else
          Result := spFinalizado;
      end;

    spEmEntrega:
      Result := spFinalizado;

  else
    Result := spFinalizado;
  end;
end;

