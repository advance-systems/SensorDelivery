procedure TfrmPrincipalAdmin.PedidoAvancarStatus(
  Sender: TObject;
  const APedidoId: Integer;
  const AStatusAtual: TStatusPedidoKanban);
var
  LFrame: TfraPedidoKanban;
  LProximoStatus: TStatusPedidoKanban;
  LDestino: TFmxObject;
  LConfirmado: Boolean;
begin
  if not (Sender is TfraPedidoKanban) then
    Exit;

  LFrame := TfraPedidoKanban(Sender);

  LProximoStatus := ProximoStatusPedido(
    AStatusAtual,
    LFrame.TipoEntrega
  );

  LConfirmado := TfrmMensagem.Exibir(
    'Alterar status',
    'Deseja avançar o pedido para "' +
    DescricaoStatus(LProximoStatus) + '"?',
    tmConfirmacao,
    True,
    'Avançar',
    'Cancelar'
  );

  if not LConfirmado then
    Exit;

  if LProximoStatus = spFinalizado then
  begin
    LFrame.AlterarStatus(spFinalizado);

    LFrame.DisposeOf;

    AtualizarContadores;

    TfrmMensagem.Exibir(
      'Pedido finalizado',
      'O pedido foi finalizado com sucesso.',
      tmSucesso
    );

    Exit;
  end;

  LDestino := ObterContainerStatus(LProximoStatus);

  if not Assigned(LDestino) then
  begin
    TfrmMensagem.Exibir(
      'Erro',
      'Não foi possível localizar a coluna de destino.',
      tmErro
    );

    Exit;
  end;

  MoverFrameParaContainer(
    LFrame,
    LDestino
  );

  LFrame.AlterarStatus(
    LProximoStatus
  );

  AtualizarContadores;
end;

