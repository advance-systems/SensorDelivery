procedure TfrmPrincipalAdmin.MoverFrameParaContainer(
  const AFrame: TfraPedidoKanban;
  const AContainer: TFmxObject);
var
  LDestinoReal: TFmxObject;
begin
  if not Assigned(AFrame) then
    Exit;

  if not Assigned(AContainer) then
    Exit;

  if AContainer is TVertScrollBox then
    LDestinoReal := TVertScrollBox(AContainer).Content
  else
    LDestinoReal := AContainer;

  AFrame.Align := TAlignLayout.None;
  AFrame.Parent := LDestinoReal;

  AFrame.Align := TAlignLayout.Top;
  AFrame.Height := 178;

  AFrame.Margins.Left := 0;
  AFrame.Margins.Top := 0;
  AFrame.Margins.Right := 0;
  AFrame.Margins.Bottom := 10;

  AFrame.BringToFront;
end;

procedure TfrmPrincipalAdmin.ConfigurarItemMenu(const ARectangle: TRectangle; const APath: TPath; const ALabel: TLabel; const ASelecionado: Boolean);
begin
  if not Assigned(ARectangle) then
    Exit;

  if ASelecionado then
  begin
    ARectangle.Fill.Color := $2A9B6CFF;

    if Assigned(APath) then
      APath.Fill.Color := $FFB996FF;

    if Assigned(ALabel) then
    begin
      ALabel.TextSettings.FontColor := $FFCAB5FF;
      ALabel.TextSettings.Font.Style := [TFontStyle.fsBold];
    end;
  end
  else
  begin
    ARectangle.Fill.Color := $00000000;

    if Assigned(APath) then
      APath.Fill.Color := $FF9CAABC;

    if Assigned(ALabel) then
    begin
      ALabel.TextSettings.FontColor := $FFD5DCE6;
      ALabel.TextSettings.Font.Style := [];
    end;
  end;
end;

