function TfrmPrincipalAdmin.ContarCards(
  const AContainer: TFmxObject): Integer;
var
  I: Integer;
  LContainerReal: TFmxObject;
begin
  Result := 0;

  if not Assigned(AContainer) then
    Exit;

  if AContainer is TVertScrollBox then
    LContainerReal := TVertScrollBox(AContainer).Content
  else
    LContainerReal := AContainer;

  for I := 0 to LContainerReal.ChildrenCount - 1 do
  begin
    if LContainerReal.Children[I] is TfraPedidoKanban then
      Inc(Result);
  end;
end;

